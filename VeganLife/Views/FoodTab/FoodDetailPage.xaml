<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="VeganLife.Views.FoodTab.FoodDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:VeganLife.Views.Base"
    xmlns:control="clr-namespace:VeganLife.Views.Controls"
    xmlns:cw="clr-namespace:VeganLife.Views.ContentViews"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Compat.Maui"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:viewmodel="clr-namespace:VeganLife.ViewModels.ContentViewModels"
    x:Name="root"
    x:DataType="viewmodel:FoodDetailViewModel"
    x:TypeArguments="viewmodel:FoodDetailViewModel"
    BackgroundColor="{AppThemeBinding Light=#f8f8f8,
                                      Dark=Black}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <x:String x:Key="iconBookmark">&#xf02e;</x:String>
            <Style TargetType="Line">
                <Setter Property="HeightRequest" Value="1.5" />
                <Setter Property="BackgroundColor" Value="#f0f0f0" />
                <Setter Property="HorizontalOptions" Value="FillAndExpand" />
            </Style>
            <Style x:Key="lbDetailMenu" TargetType="Label">
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="Margin" Value="10" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid
        Grid.Row="1"
        RowDefinitions="2*,3*"
        ZIndex="0">
        <control:NavBarControl
            BackgroundColor="Transparent"
            VerticalOptions="Start"
            ZIndex="1" />
        <Grid>
            <ffimageloading:CachedImage
                x:Name="imgPreview"
                Aspect="AspectFill"
                DownsampleToViewSize="True"
                HorizontalOptions="FillAndExpand"
                PropertyChanged="Image_PropertyChanged"
                Source="{Binding FoodPreview.Image, Mode=OneWay}"
                VerticalOptions="Start" />
        </Grid>
        <Grid
            Grid.Row="1"
            Grid.RowSpan="2"
            Margin="15,0">
            <ScrollView>
                <VerticalStackLayout Margin="5,0" BackgroundColor="Transparent">
                    <Grid BackgroundColor="Transparent" HeightRequest="{Binding MarginTopContent, Source={x:Reference root}, Mode=OneWay}" />
                    <Frame
                        Padding="0"
                        BorderColor="Transparent"
                        CornerRadius="20"
                        HasShadow="True">
                        <Grid
                            Margin="10,10,0,10"
                            ColumnDefinitions="4*,*"
                            PropertyChanged="Frame_PropertyChanged"
                            RowDefinitions="*"
                            VerticalOptions="FillAndExpand">
                            <VerticalStackLayout Margin="10,0,0,0" Spacing="8">
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="PlayfairDisplaySemiBold"
                                    FontSize="18"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Text="{Binding FoodPreview.Name, Mode=OneWay}" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                BackgroundColor="Transparent"
                                Command="{Binding BookmarkClickedCommand}"
                                FontFamily="FontAwesomeRegular"
                                FontSize="20"
                                HorizontalOptions="Center"
                                Text="{StaticResource iconBookmark}"
                                TextColor="Black"
                                VerticalOptions="Center">
                                <Button.Triggers>
                                    <DataTrigger
                                        Binding="{Binding FoodPreview.IsBookmarked}"
                                        TargetType="Button"
                                        Value="true">
                                        <Setter Property="FontFamily" Value="FontAwesomeSolid" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </Frame>
                    <Border
                        Margin="0,20"
                        Padding="0"
                        Stroke="#f0f0f0"
                        StrokeThickness="2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout
                            Padding="0"
                            Spacing="10"
                            VerticalOptions="Start">
                            <cw:ElementFoodDetailCW Title="{x:Static translate:AppResources.ingredient_foodDetailPage}" ContentExpand="{Binding FoodDetail.Ingredient, Mode=OneWay}" />
                            <cw:ElementFoodDetailCW Title="{x:Static translate:AppResources.making_foodDetailPage}" ContentExpand="{Binding FoodDetail.Making, Mode=OneWay}" />
                            <cw:ElementFoodDetailCW Title="{x:Static translate:AppResources.sauce_foodDetailPage}" ContentExpand="{Binding FoodDetail.Sauce, Mode=OneWay}" />
                            <cw:ElementFoodDetailCW Title="{x:Static translate:AppResources.decorate_foodDetailPage}" ContentExpand="{Binding FoodDetail.Decorate, Mode=OneWay}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</base:BasePage>