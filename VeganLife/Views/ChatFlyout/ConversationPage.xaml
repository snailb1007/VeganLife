<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VeganLife.Views.ChatFlyout.ConversationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:control="clr-namespace:VeganLife.Views.Controls"
    xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
    xmlns:templates="clr-namespace:VeganLife.Views.Templates"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:vm="clr-namespace:VeganLife.ViewModels"
    x:Name="ConversationPageRoot"
    Title="HealthyChef - beta"
    x:DataType="vm:ConversationViewModel"
    BackgroundColor="#f8f8f8">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding BindingContext.CurrentChat.TimesLimit, Source={x:Reference ConversationPageRoot}}" />
        <ToolbarItem
            Command="{Binding BindingContext.OpenDisclaimerPopupCommand, Source={x:Reference ConversationPageRoot}}"
            Order="Secondary"
            Text="Disclaimer" />
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
        </ResourceDictionary>
        <DataTemplate x:Key="UserMessageItemTemplate">
            <templates:UserMessItemTemplate />
        </DataTemplate>
        <DataTemplate x:Key="BotMessageItemTemplate">
            <templates:BotMessItemTemplate />
        </DataTemplate>
        <templates:ChatMessDataTemplateSelector
            x:Key="MessageDataTemplateSelector"
            BotMessageTemplate="{StaticResource BotMessageItemTemplate}"
            UserMessageItemTemplate="{StaticResource UserMessageItemTemplate}" />
    </ContentPage.Resources>
    <Grid IsEnabled="{Binding IsTrustedSetting, Mode=OneWay}" RowDefinitions="48, *, Auto">
        <Grid
            Background="{StaticResource Yellow200Accent}"
            ColumnDefinitions="*,Auto"
            IsVisible="True">
            <!--<Grid.Triggers>
                <DataTrigger
                    Binding="{Binding CurrentChat.TimesLimit}"
                    TargetType="Grid"
                    Value="0">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>
            </Grid.Triggers>-->
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenRewardedAdPageCommand}" />
            </Grid.GestureRecognizers>
            <Label
                HorizontalOptions="Center"
                Text="Your points is 0. Get more point &gt;&gt;"
                VerticalOptions="Center">
                <Label.Triggers>
                    <DataTrigger
                        Binding="{Binding CurrentAdValidatorData.RewardAdTimesLimit}"
                        TargetType="Label"
                        Value="2">
                        <Setter Property="Text" Value="Times limited! u can get more point" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding Source={x:Reference countDownLb}, Path=IsVisible}"
                        TargetType="Label"
                        Value="True">
                        <Setter Property="Text" Value="Waiting for ready get more point in next times!" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <!--<GraphicsView
                x:Name="GraphicsViewCountDown"
                Grid.Column="1"
                BackgroundColor="Aqua"
                HeightRequest="42"
                WidthRequest="42">
                <GraphicsView.Drawable>
                    <control:ProgressDrawableControl
                        ParentView="{Binding Source={x:Reference GraphicsViewCountDown}}"
                        ProgressColor="{StaticResource PrimaryOrange}"
                        ProgressLeftColor="{StaticResource PrimaryOrange2}"
                        Size="40"
                        TextColor="{StaticResource PrimaryLight}"
                        Thickness="2" />
                </GraphicsView.Drawable>
            </GraphicsView>-->
            <Label
                x:Name="countDownLb"
                Grid.Column="1"
                IsVisible="{Binding CountDownText, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                VerticalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Ready on " />
                        <Span Text="{Binding CountDownText}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </Grid>
        <Border
            Grid.Row="1"
            Padding="16,10"
            BackgroundColor="Transparent"
            StrokeShape="RoundRectangle 0,0,10,10"
            StrokeThickness="0">
            <CollectionView
                x:Name="messCollection"
                ItemTemplate="{StaticResource MessageDataTemplateSelector}"
                ItemsSource="{Binding Messages, Mode=OneWay}"
                VerticalOptions="End">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="20" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label
                        Margin="20,0"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static translate:AppResources.emptyChat_conversationChat}"
                        VerticalOptions="Center" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Border>
        <Grid
            Grid.Row="2"
            Padding="16,10,10,10"
            ColumnDefinitions="*, Auto, Auto"
            ColumnSpacing="10">
            <Grid.Background>
                <LinearGradientBrush EndPoint="1,0">
                    <GradientStop Offset="0.1" Color="{StaticResource PrimaryOrange2}" />
                    <GradientStop Offset="1.0" Color="{StaticResource PrimaryDark}" />
                </LinearGradientBrush>
            </Grid.Background>
            <Border
                Grid.Column="0"
                BackgroundColor="{StaticResource PrimaryLight}"
                StrokeShape="RoundRectangle 36">
                <Grid ColumnDefinitions="*, 50">
                    <Editor
                        Margin="16,0"
                        MaxLength="100"
                        MaximumHeightRequest="100"
                        MinimumHeightRequest="48"
                        Placeholder="Enter text here..."
                        Text="{Binding Query, Mode=TwoWay}"
                        TextColor="{StaticResource Gray100}"
                        TranslationY="4" />
                    <skia:SKLottieView
                        Grid.Column="1"
                        HeightRequest="48"
                        HorizontalOptions="Center"
                        IsVisible="{Binding IsLoading}"
                        RepeatCount="-1"
                        Source="loading.json"
                        VerticalOptions="Center"
                        WidthRequest="48" />
                </Grid>
            </Border>
            <ImageButton
                Grid.Column="1"
                Padding="10"
                Aspect="AspectFit"
                BackgroundColor="{StaticResource PrimaryOrange2}"
                BorderColor="{StaticResource PrimaryOrange1}"
                BorderWidth="5"
                Command="{Binding CurrentCommand}"
                CornerRadius="10"
                HeightRequest="48"
                Opacity="0.8"
                Source="send"
                WidthRequest="48" />
        </Grid>
    </Grid>
</ContentPage>
