<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VeganLife.Views.ChatFlyout.ConversationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
    xmlns:templates="clr-namespace:VeganLife.Views.Templates"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:vm="clr-namespace:VeganLife.ViewModels"
    Title="Hoi dap online"
    x:DataType="vm:ConversationViewModel"
    BackgroundColor="#f8f8f8"
    HideSoftInputOnTapped="True">
    <ContentPage.Resources>
        <DataTemplate x:Key="UserMessageItemTemplate">
            <templates:UserMessItemTemplate />
        </DataTemplate>
        <DataTemplate x:Key="BotMessageItemTemplate">
            <templates:BotMessItemTemplate />
        </DataTemplate>
        <templates:ChatMessDataTemplateSelector
            x:Key="MessageDataTemplateSelector"
            BotMessageTemplate="{StaticResource BotMessageItemTemplate}"
            UserMessageItemTemplate="{StaticResource UserMessageItemTemplate}" />
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto, *, 16, Auto, 16">
        <Border
            Grid.Row="1"
            Padding="16,0"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColorLight},
                                              Dark={StaticResource SurfaceColorDark}}"
            StrokeShape="RoundRectangle 0,0,36,36"
            StrokeThickness="0">
            <CollectionView
                x:Name="messCollection"
                ItemTemplate="{StaticResource MessageDataTemplateSelector}"
                ItemsSource="{Binding Messages, Mode=OneWay}"
                VerticalOptions="End">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="20" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label
                        Margin="20,0"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static translate:AppResources.emptyChat_conversationChat}"
                        VerticalOptions="Center" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Border>
        <Label HorizontalOptions="Center" Text="{Binding CurrentChat.TimesLimit}" />
        <Grid
            Grid.Row="3"
            Padding="16,0"
            ColumnDefinitions="*, Auto, Auto"
            ColumnSpacing="10">
            <Border
                Grid.Column="0"
                BackgroundColor="{StaticResource PrimaryLight}"
                HeightRequest="48"
                StrokeShape="RoundRectangle 36">
                <Grid ColumnDefinitions="*, Auto">
                    <Entry
                        Margin="16,0"
                        Placeholder="Enter text here..."
                        Text="{Binding Query, Mode=TwoWay}"
                        TextColor="{StaticResource Gray100}"
                        TranslationY="4" />
                    <skia:SKLottieView
                        Grid.Column="1"
                        HeightRequest="48"
                        HorizontalOptions="Center"
                        IsVisible="{Binding IsLoading}"
                        RepeatCount="-1"
                        Source="loading.json"
                        VerticalOptions="Center"
                        WidthRequest="48" />
                </Grid>
            </Border>
            <ImageButton
                Grid.Column="1"
                Padding="5"
                Aspect="AspectFit"
                Command="{Binding CurrentCommand}"
                CornerRadius="24"
                HeightRequest="48"
                Source="send"
                WidthRequest="48" />
        </Grid>
    </Grid>
</ContentPage>
