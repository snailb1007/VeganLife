<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VeganLife.Views.ChatFlyout.ConversationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
    xmlns:templates="clr-namespace:VeganLife.Views.Templates"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:vm="clr-namespace:VeganLife.ViewModels"
    x:Name="ConversationPageRoot"
    Title="HealthyChef - beta"
    x:DataType="vm:ConversationViewModel"
    BackgroundColor="#f8f8f8">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding CurrentChat.TimesLimit}" />
        <ToolbarItem
            Command="{Binding OpenDisclaimerPopupCommand}"
            Order="Secondary"
            Text="{x:Static translate:AppResources.disclaimer_common}" />
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
        </ResourceDictionary>
        <DataTemplate x:Key="UserMessageItemTemplate">
            <templates:UserMessItemTemplate />
        </DataTemplate>
        <DataTemplate x:Key="BotMessageItemTemplate">
            <templates:BotMessItemTemplate />
        </DataTemplate>
        <templates:ChatMessDataTemplateSelector
            x:Key="MessageDataTemplateSelector"
            BotMessageTemplate="{StaticResource BotMessageItemTemplate}"
            UserMessageItemTemplate="{StaticResource UserMessageItemTemplate}" />
    </ContentPage.Resources>
    <Grid IsEnabled="{Binding IsTrustedSetting, Mode=OneWay}" RowDefinitions="48, *, Auto">
        <Grid
            Background="{StaticResource Yellow200Accent}"
            ColumnDefinitions="*,Auto"
            IsVisible="True"
            Opacity="0.8">
            <Grid.Triggers>
                <DataTrigger
                    Binding="{Binding CurrentChat.TimesLimit}"
                    TargetType="Grid"
                    Value="0">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Grid.Triggers>
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenRewardedAdPageCommand}" />
            </Grid.GestureRecognizers>
            <Label
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Text="{Binding AdRewardedDescription}"
                VerticalOptions="Center">
                <Label.Triggers>
                    <DataTrigger
                        Binding="{Binding AdRewardedDescription}"
                        TargetType="Label"
                        Value="{x:Static translate:AppResources.cantCollect_info_label}">
                        <Setter Property="TextColor" Value="Gray" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding AdRewardedDescription}"
                        TargetType="Label"
                        Value="{x:Static translate:AppResources.waitingForCollect_info_label}">
                        <Setter Property="TextColor" Value="Gray" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Label
                x:Name="countDownLb"
                Grid.Column="1"
                Margin="2,0"
                HorizontalOptions="Center"
                IsVisible="{Binding CountDownText, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                VerticalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Ready on " />
                        <Span Text="{Binding CountDownText}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </Grid>
        <Border
            Grid.Row="1"
            Padding="16,10"
            BackgroundColor="Transparent"
            StrokeShape="RoundRectangle 0,0,10,10"
            StrokeThickness="0">
            <CollectionView
                x:Name="messCollection"
                ItemTemplate="{StaticResource MessageDataTemplateSelector}"
                ItemsSource="{Binding Messages, Mode=OneWay}"
                VerticalOptions="End">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="20" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label
                        Margin="20,0"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static translate:AppResources.emptyChat_conversationChat}"
                        VerticalOptions="Center" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Border>
        <Grid
            Grid.Row="2"
            Padding="16,10,10,10"
            ColumnDefinitions="*, Auto"
            ColumnSpacing="10"
            RowDefinitions="Auto">
            <Grid.Background>
                <LinearGradientBrush EndPoint="1,0">
                    <GradientStop Offset="0.1" Color="{StaticResource PrimaryOrange2}" />
                    <GradientStop Offset="1.0" Color="{StaticResource PrimaryDark}" />
                </LinearGradientBrush>
            </Grid.Background>
            <Border
                Grid.Column="0"
                BackgroundColor="{StaticResource PrimaryLight}"
                StrokeShape="RoundRectangle 36">
                <Editor
                    Margin="16,0"
                    AutoSize="TextChanges"
                    MaxLength="100"
                    MaximumHeightRequest="100"
                    MinimumHeightRequest="48"
                    Placeholder="Enter text here..."
                    Text="{Binding Query, Mode=TwoWay}"
                    TextColor="{StaticResource Gray100}"
                    TranslationY="4" />
            </Border>
            <ImageButton
                Grid.Column="1"
                Padding="10"
                Aspect="AspectFit"
                BackgroundColor="{StaticResource PrimaryOrange2}"
                BorderColor="{StaticResource PrimaryOrange1}"
                BorderWidth="5"
                Command="{Binding CurrentCommand}"
                CornerRadius="10"
                HeightRequest="48"
                Opacity="0.8"
                Source="send"
                WidthRequest="48" />
        </Grid>

        <ContentView
            Grid.RowSpan="3"
            ControlTemplate="{StaticResource LoadingAnimationTemplate}"
            IsVisible="{Binding IsAdInProgress}" />
    </Grid>
</ContentPage>
