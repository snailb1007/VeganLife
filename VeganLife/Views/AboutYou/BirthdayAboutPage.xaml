<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="VeganLife.Views.AboutYou.BirthdayAboutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:VeganLife.Views.Base"
    xmlns:sharpnado="http://sharpnado.com"
    xmlns:viewmodel="clr-namespace:VeganLife.ViewModels"
    Title="Step 2 of 5"
    x:DataType="viewmodel:BirthdayAboutPageVM"
    x:TypeArguments="viewmodel:BirthdayAboutPageVM"
    BackgroundColor="White">
    <VerticalStackLayout Margin="20,20,20,0">
        <Label
            FontAttributes="Bold"
            FontSize="32"
            HorizontalOptions="Start"
            Text="When were you born, thien?" />
        <Label Text="So that we know how to call you" />
        <sharpnado:MaterialFrame
            Margin="0,20,0,0"
            Padding="10"
            CornerRadius="15"
            MaterialTheme="Acrylic">
            <Grid Margin="5,0,10,0">
                <DatePicker
                    FontSize="Large"
                    HorizontalOptions="Start"
                    MaximumDate="{Binding MaximumDateOfBirth}"
                    MinimumDate="01/01/1977"
                    VerticalOptions="Center" />
                <Label
                    FontFamily="FASolid"
                    FontSize="Large"
                    HorizontalOptions="End"
                    Text="&#xf736;"
                    VerticalOptions="Center" />
            </Grid>
        </sharpnado:MaterialFrame>
        <Button Margin="10,20,10,0" Text="Continue" />
    </VerticalStackLayout>
</base:BasePage>