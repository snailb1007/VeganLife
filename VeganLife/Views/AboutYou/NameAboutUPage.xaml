<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="VeganLife.Views.AboutYou.NameAboutUPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:VeganLife.Views.Base"
    xmlns:sharpnado="http://sharpnado.com"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:viewmodel="clr-namespace:VeganLife.ViewModels"
    Title="Step 1 of 4"
    x:DataType="viewmodel:NameAboutUPageVM"
    x:TypeArguments="viewmodel:NameAboutUPageVM"
    BackgroundColor="White">
    <VerticalStackLayout Margin="20,20,20,0" Spacing="20">
        <Label
            FontAttributes="Bold"
            FontSize="32"
            HorizontalOptions="Start"
            Text="What's your name?" />
        <Label Text="So that we know how to call you" />
        <sharpnado:MaterialFrame
            Margin="0,20,0,0"
            Padding="10"
            CornerRadius="15"
            MaterialTheme="Acrylic">
            <Entry
                HeightRequest="48"
                Placeholder="Your full name"
                VerticalOptions="Center" />
        </sharpnado:MaterialFrame>
        <Button
            Margin="10,20"
            Command="{Binding NextClickedCommand}"
            Text="Next" />
        <Label Text="{x:Static translate:AppResources.app_common_dataNote}" TextColor="Red" />
    </VerticalStackLayout>
</base:BasePage>