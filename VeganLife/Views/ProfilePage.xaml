<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VeganLife.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <ContentPage.Background>
        <LinearGradientBrush EndPoint="0,1">
            <GradientStop Offset="0.1" Color="{StaticResource PrimaryDark}" />
            <GradientStop Offset="1.0" Color="{StaticResource PrimaryLight}" />
        </LinearGradientBrush>
    </ContentPage.Background>
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="White" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid RowDefinitions="*,3*,6*" RowSpacing="0">
            <Grid>
                <Line
                    Margin="10,0"
                    BackgroundColor="#0d625c"
                    HeightRequest="1"
                    VerticalOptions="End" />
            </Grid>
            <Grid
                Grid.Row="1"
                Margin="20"
                BackgroundColor="Transparent">
                <Border
                    BackgroundColor="{StaticResource PrimaryLight}"
                    Stroke="#1f807b"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1">
                    <StackLayout
                        Margin="10"
                        BackgroundColor="Transparent"
                        Spacing="10">
                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="Nguoi la" />
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Do hoan thien" VerticalOptions="Center" />
                            <Border
                                BackgroundColor="#fcd684"
                                Stroke="#e3e4a0"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="1">
                                <HorizontalStackLayout Padding="5" Spacing="5">
                                    <Label Text="Co ve on roi" TextColor="Black" />
                                    <Label Text="75%" TextColor="Black" />
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                        <Border
                            Margin="5,0"
                            BackgroundColor="{StaticResource PrimaryDark}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0"
                            VerticalOptions="EndAndExpand">
                            <Grid
                                Padding="0,5"
                                ColumnDefinitions="*,*,*,*"
                                ColumnSpacing="10"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="10">
                                <Grid.Resources>
                                    <ResourceDictionary>
                                        <Style TargetType="Label">
                                            <Setter Property="TextColor" Value="White" />
                                            <Setter Property="HorizontalOptions" Value="Center" />
                                        </Style>
                                    </ResourceDictionary>
                                </Grid.Resources>
                                <Label Text="Tuoi" />
                                <Label
                                    Grid.Row="1"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="25" />
                                <Label Grid.Column="1" Text="Sex" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="Nam" />
                                <Label Grid.Column="2" Text="Can nang" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="55kg" />
                                <Label Grid.Column="3" Text="Chieu cao" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="170cm" />
                            </Grid>
                        </Border>
                    </StackLayout>
                </Border>
            </Grid>
            <VerticalStackLayout
                Grid.Row="2"
                Margin="20"
                Spacing="10">
                <Label
                    FontAttributes="Bold"
                    FontSize="30"
                    Text="Thong tin them" />
                <Border
                    Margin="0,10,0,0"
                    BackgroundColor="{StaticResource PrimaryLight}"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0">
                    <Grid
                        Padding="5,15"
                        ColumnDefinitions="2*,7*,*"
                        ColumnSpacing="10">
                        <Border
                            Margin="5"
                            BackgroundColor="#fcd684"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0">
                            <Image Margin="10" Source="bmi_profile.svg" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Chi so BMI" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="23" />
                        </VerticalStackLayout>
                        <Label
                            Grid.Column="2"
                            FontFamily="{StaticResource FontAwesomeSolid}"
                            Text="{StaticResource IconAngleDown}"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Border
                    BackgroundColor="#fcd684"
                    Stroke="#e3e4a0"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1">
                    <Border.Resources>
                        <ResourceDictionary>
                            <Style TargetType="Label">
                                <Setter Property="TextColor" Value="Black" />
                            </Style>
                        </ResourceDictionary>
                    </Border.Resources>
                    <VerticalStackLayout Padding="5,15" Spacing="10">
                        <Grid ColumnDefinitions="2*,7*,*" ColumnSpacing="10">
                            <Border
                                Margin="5"
                                Padding="0"
                                BackgroundColor="White"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0">
                                <Image Margin="10" Source="readed_profile.svg" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Opacity="0.8" Text="Tổng số bài đã đọc" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="23" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="2"
                                FontFamily="{StaticResource FontAwesomeSolid}"
                                FontSize="20"
                                Text="{StaticResource IconAngleDown}"
                                VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label
                                    HorizontalOptions="Center"
                                    Opacity="0.8"
                                    Text="Món ăn" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    HorizontalOptions="Center"
                                    Text="100" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                                <Label
                                    HorizontalOptions="Center"
                                    Opacity="0.8"
                                    Text="Món ăn" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    HorizontalOptions="Center"
                                    Text="100" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                                <Label
                                    HorizontalOptions="Center"
                                    Opacity="0.8"
                                    Text="Món ăn" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    HorizontalOptions="Center"
                                    Text="100" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>