<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VeganLife.Views.SettingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:viewmodel="clr-namespace:VeganLife.ViewModels"
    x:Name="settingRoot"
    Title="{x:Static translate:AppResources.app_common_settingTab}"
    x:DataType="viewmodel:SettingViewModel">
    <ContentPage.BackgroundImageSource>
        <UriImageSource Uri="{Binding Source={x:Reference settingRoot}, Path=BindingContext.ImgBackground}" />
    </ContentPage.BackgroundImageSource>
    <VerticalStackLayout Margin="10,10,10,0" Spacing="10">
        <Label
            Margin="0,10,0,0"
            Text="Tùy chọn"
            TextColor="Gray" />
        <StackLayout
            Margin="0"
            Padding="0"
            HorizontalOptions="Fill"
            Orientation="Horizontal">
            <Label
                Margin="0,0,10,0"
                FontFamily="AwesomeSolid"
                FontSize="20"
                HorizontalOptions="Start"
                Text="{AppThemeBinding Dark=&#xf186;,
                                       Light=&#xf185;}"
                TextColor="{AppThemeBinding Dark=White,
                                            Light=Orange}"
                VerticalOptions="Start" />
            <VerticalStackLayout Spacing="5">
                <Label Text="{AppThemeBinding Dark=Tối, Light=Sáng}" VerticalOptions="Start" />
                <Frame
                    Padding="0"
                    BackgroundColor="Transparent"
                    BorderColor="Gray"
                    CornerRadius="10"
                    IsClippedToBounds="True">
                    <HorizontalStackLayout>
                        <Picker
                            x:Name="pickerTheme"
                            Title="Style"
                            HorizontalTextAlignment="Center"
                            ItemsSource="{Binding ThemeSkins}"
                            SelectedIndex="{Binding IndexPickerOption}"
                            VerticalOptions="Start"
                            VerticalTextAlignment="Center"
                            WidthRequest="60" />
                        <Label
                            Margin="1,0,2,0"
                            FontFamily="AwesomeSolid"
                            Text="&#xf0d7;"
                            VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger
                                    Binding="{Binding Source={x:Reference pickerTheme}, Path=IsLoaded}"
                                    TargetType="Label"
                                    Value="True">
                                    <Setter Property="Text" Value="&#xf0d8;" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding Source={x:Reference pickerTheme}, Path=IsLoaded}"
                                    TargetType="Label"
                                    Value="False">
                                    <Setter Property="Text" Value="&#xf0d7;" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                </Frame>
            </VerticalStackLayout>
            <Frame
                Padding="1"
                BackgroundColor="{AppThemeBinding Dark=Gray,
                                                  Light=White}"
                BorderColor="Transparent"
                HasShadow="False"
                HorizontalOptions="EndAndExpand"
                VerticalOptions="StartAndExpand">
                <Switch
                    HorizontalOptions="Center"
                    IsToggled="{Binding IsDarkMode}"
                    OnColor="{AppThemeBinding Dark=White,
                                              Light=Gray}"
                    ThumbColor="Green"
                    Toggled="Switch_Toggled"
                    VerticalOptions="Center" />
            </Frame>
        </StackLayout>

        <Label
            Margin="0,10,0,0"
            Text="Bộ công cụ"
            TextColor="Gray" />
        <Label Text="Tính BMI">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoToolsCommand}" CommandParameter="bmi" />
            </Label.GestureRecognizers>
        </Label>
        <Label Text="Tính BMR">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoToolsCommand}" CommandParameter="bmr" />
            </Label.GestureRecognizers>
        </Label>

        <Label
            Margin="0,10,0,0"
            HorizontalOptions="Start"
            Text="Thông tin kỹ thuật"
            TextColor="Gray"
            VerticalOptions="Start" />
        <Label
            HorizontalOptions="Start"
            Text="Phiên bản"
            VerticalOptions="Start" />
        <Label HorizontalOptions="Start" Text="Giấy phép" />
    </VerticalStackLayout>
</ContentPage>