<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="VeganLife.Views.SettingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:VeganLife.Views.Base"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:viewmodel="clr-namespace:VeganLife.ViewModels"
    x:Name="settingRoot"
    Title="{x:Static translate:AppResources.app_common_settingTab}"
    x:DataType="viewmodel:SettingViewModel"
    x:TypeArguments="viewmodel:SettingViewModel">
    <ContentPage.BackgroundImageSource>
        <UriImageSource Uri="{Binding Source={x:Reference settingRoot}, Path=BindingContext.ImgBackground}" />
    </ContentPage.BackgroundImageSource>
    <VerticalStackLayout Margin="10,10,10,0" Spacing="10">
        <Label
            Margin="0,10,0,0"
            Text="Tùy chọn"
            TextColor="Gray" />
        <StackLayout
            Margin="0"
            Padding="0"
            HorizontalOptions="Fill"
            Orientation="Horizontal">
            <Label
                Margin="0,0,10,0"
                FontFamily="FontAwesomeSolid"
                FontSize="20"
                HorizontalOptions="Start"
                Text="{AppThemeBinding Dark=&#xf186;,
                                       Light=&#xf185;}"
                TextColor="{AppThemeBinding Dark=White,
                                            Light=Orange}"
                VerticalOptions="Center" />
            <Label Text="{AppThemeBinding Dark=Tối, Light=Sáng}" VerticalOptions="Center" />
            <Frame
                Padding="1"
                BackgroundColor="Transparent"
                BorderColor="Transparent"
                HasShadow="False"
                HorizontalOptions="EndAndExpand"
                VerticalOptions="StartAndExpand">
                <Switch
                    BackgroundColor="{AppThemeBinding Dark=Gray,
                                                      Light=White}"
                    HorizontalOptions="Center"
                    IsToggled="{Binding IsDarkMode}"
                    OnColor="{AppThemeBinding Dark=White,
                                              Light=Gray}"
                    ThumbColor="Green"
                    Toggled="Switch_Toggled"
                    VerticalOptions="Center" />
            </Frame>
        </StackLayout>
        <Label
            Margin="0,10,0,0"
            HorizontalOptions="Start"
            Text="Thông tin kỹ thuật"
            TextColor="Gray"
            VerticalOptions="Start" />
        <Label
            HorizontalOptions="Start"
            Text="Phiên bản"
            VerticalOptions="Start" />
        <Label HorizontalOptions="Start" Text="Giấy phép" />
    </VerticalStackLayout>
</base:BasePage>