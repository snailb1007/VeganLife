<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VeganLife.Views.BMICalculatorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="BMI calculator">
    <VerticalStackLayout Margin="10,10,10,0" Spacing="10">
        <HorizontalStackLayout HorizontalOptions="CenterAndExpand" Spacing="5">
            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="Bản dạng giới" />
            <Label
                FontFamily="AwesomeSolid"
                FontSize="15"
                Text="&#xf05a;"
                TextColor="CadetBlue" />
        </HorizontalStackLayout>

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
            <Frame
                Padding="5"
                BackgroundColor="Transparent"
                BorderColor="CadetBlue"
                CornerRadius="5">
                <Label
                    FontFamily="AwesomeSolid"
                    FontSize="20"
                    Text="&#xf221;"
                    VerticalOptions="Center" />
            </Frame>
            <Frame
                Padding="5"
                BackgroundColor="Transparent"
                BorderColor="CadetBlue"
                CornerRadius="5">
                <Label
                    Grid.Column="1"
                    FontFamily="AwesomeSolid"
                    FontSize="20"
                    Text="&#xf222;"
                    VerticalOptions="Center" />
            </Frame>
        </HorizontalStackLayout>
        <Grid ColumnDefinitions="*,6*,*">
            <Frame
                Grid.Column="1"
                Padding="5"
                BackgroundColor="Transparent"
                BorderColor="Gray"
                CornerRadius="5"
                IsClippedToBounds="True">
                <VerticalStackLayout Margin="5" Spacing="5">
                    <Label
                        Margin="0,0,0,10"
                        FontAttributes="Bold"
                        FontSize="25"
                        HorizontalOptions="Center"
                        Text="Chiều cao" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                        <Label
                            FontSize="27"
                            Text="{Binding Source={x:Reference sliderHeight}, Path=Value, StringFormat='{0:F1}'}"
                            VerticalOptions="Center" />
                        <Label Text="cm" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,5*,*" HorizontalOptions="FillAndExpand">
                        <Slider
                            x:Name="sliderHeight"
                            Grid.Column="1"
                            HorizontalOptions="FillAndExpand"
                            Maximum="250"
                            Minimum="50"
                            VerticalOptions="FillAndExpand" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </VerticalStackLayout>
</ContentPage>