<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="VeganLife.Views.Controls.NavBarControl"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="rootNavBarControl"
    BackgroundColor="Transparent">
    <Grid
        Margin="16,0"
        BackgroundColor="Transparent"
        ColumnDefinitions="*, 8*, *"
        HeightRequest="56">
        <ImageButton
            Aspect="AspectFill"
            Clicked="Back_Clicked"
            HeightRequest="30"
            HorizontalOptions="Center"
            Source="back"
            VerticalOptions="Center"
            WidthRequest="30" />
        <Label
            Grid.Column="1"
            FontAttributes="Bold"
            FontSize="Medium"
            HorizontalOptions="Center"
            Text="{Binding Title, Source={x:Reference rootNavBarControl}}"
            VerticalOptions="Center" />
    </Grid>
</ContentView>
