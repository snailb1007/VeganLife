<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="VeganLife.Views.Controls.NavBarControl"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sharpnado="http://sharpnado.com"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="rootNavBarControl"
    BackgroundColor="Transparent">
    <ContentView.Background>
        <LinearGradientBrush EndPoint="0,1">
            <GradientStop Offset="0.1" Color="{StaticResource PrimaryDark}" />
            <GradientStop Offset="1.0" Color="{StaticResource PrimaryLight}" />
        </LinearGradientBrush>
    </ContentView.Background>
    <ContentView.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
    </ContentView.Resources>
    <Grid
        Margin="16,0"
        BackgroundColor="Transparent"
        ColumnDefinitions="Auto, *, 48"
        HeightRequest="56">
        <sharpnado:MaterialFrame
            Padding="0"
            CornerRadius="20"
            HasShadow="True"
            HeightRequest="40"
            HorizontalOptions="Center"
            LightThemeBackgroundColor="#F1F1F1"
            MaterialTheme="Acrylic"
            VerticalOptions="Center">
            <HorizontalStackLayout Margin="5,0" Spacing="5">
                <Button
                    Margin="0"
                    Padding="0"
                    BackgroundColor="Transparent"
                    Clicked="Back_Clicked"
                    FontFamily="FARegular"
                    FontSize="20"
                    HeightRequest="40"
                    HorizontalOptions="FillAndExpand"
                    Text="&#xf104;"
                    TextColor="{AppThemeBinding Dark=White,
                                                Light=Black}"
                    VerticalOptions="FillAndExpand"
                    WidthRequest="30" />
                <Line
                    BackgroundColor="Gray"
                    HeightRequest="18"
                    Opacity="0.25"
                    VerticalOptions="Center"
                    WidthRequest="2" />
                <ImageButton
                    Margin="0"
                    Padding="0"
                    AutomationProperties.IsInAccessibleTree="False"
                    BorderColor="Transparent"
                    Clicked="Hamburger_Clicked"
                    HeightRequest="30"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="hamburger image button"
                    SemanticProperties.Hint="Open flyout menu"
                    Source="hamburger.svg"
                    VerticalOptions="Center"
                    WidthRequest="30" />
            </HorizontalStackLayout>
        </sharpnado:MaterialFrame>
        <Label
            Grid.Row="1"
            Grid.Column="1"
            FontAttributes="Bold"
            FontSize="Medium"
            HorizontalOptions="Center"
            IsVisible="{Binding Title, Source={x:Reference rootNavBarControl}, Converter={StaticResource IsStringNotNullOrEmptyConverter}, Mode=OneWay}"
            Text="{Binding Title, Source={x:Reference rootNavBarControl}, Mode=OneWay}"
            TextColor="White"
            VerticalOptions="Center" />
        <sharpnado:MaterialFrame
            x:Name="affiliationsShoFrame"
            Grid.Column="2"
            Padding="0"
            CornerRadius="20"
            HeightRequest="44"
            IsVisible="False"
            LightThemeBackgroundColor="{StaticResource PrimaryOrange2}"
            WidthRequest="44">
            <sharpnado:MaterialFrame.GestureRecognizers>
                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
            </sharpnado:MaterialFrame.GestureRecognizers>
            <Label
                FontFamily="FALight"
                FontSize="25"
                HorizontalOptions="Center"
                Text="&#xf670;"
                TextColor="Black"
                VerticalOptions="Center" />
        </sharpnado:MaterialFrame>
    </Grid>
</ContentView>
