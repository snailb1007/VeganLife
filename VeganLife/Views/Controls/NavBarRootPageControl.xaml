<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="VeganLife.Views.Controls.NavBarRootPageControl"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="navBarRootContent">
    <Grid
        ColumnDefinitions="45, *, 45"
        ColumnSpacing="0"
        RowDefinitions="45">
        <Border
            BackgroundColor="{AppThemeBinding Dark=Black,
                                              Light=White}"
            HeightRequest="40"
            HorizontalOptions="Center"
            Stroke="{StaticResource PrimaryLight}"
            StrokeThickness="1"
            VerticalOptions="Center"
            WidthRequest="40">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <ImageButton
                Margin="0"
                Padding="0"
                Clicked="ImageButton_Clicked"
                HeightRequest="30"
                HorizontalOptions="Center"
                IsVisible="{Binding IsVisibleGreetingContent, Source={x:Reference navBarRootContent}, Mode=OneWay}"
                Source="hamburger.svg"
                VerticalOptions="Center"
                WidthRequest="30">
                <ImageButton.Behaviors>
                    <toolkit:AnimationBehavior>
                        <toolkit:AnimationBehavior.AnimationType>
                            <toolkit:FadeAnimation Opacity="0.5" />
                        </toolkit:AnimationBehavior.AnimationType>
                    </toolkit:AnimationBehavior>
                </ImageButton.Behaviors>
            </ImageButton>
        </Border>
        <Grid Grid.Column="1">
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="10"
                VerticalOptions="Center">
                <Label
                    FontAttributes="Bold"
                    HorizontalOptions="StartAndExpand"
                    Text="Hi, ..."
                    VerticalOptions="Center" />
                <Image
                    HorizontalOptions="End"
                    IsAnimationPlaying="True"
                    PropertyChanged="Image_PropertyChanged"
                    Source="hand.svg"
                    WidthRequest="30" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentView>
