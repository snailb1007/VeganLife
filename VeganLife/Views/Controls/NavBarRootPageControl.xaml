<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="VeganLife.Views.Controls.NavBarRootPageControl"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="navBarRootContent">
    <Grid
        ColumnDefinitions="45, *, 45"
        ColumnSpacing="0"
        RowDefinitions="45">
        <Border
            BackgroundColor="{AppThemeBinding Dark=Black,
                                              Light=White}"
            HeightRequest="42"
            HorizontalOptions="Center"
            Stroke="{StaticResource PrimaryLight}"
            StrokeThickness="1"
            VerticalOptions="Center"
            WidthRequest="42">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <ImageButton
                Margin="0"
                Padding="0"
                BorderColor="Transparent"
                Clicked="ImageButton_Clicked"
                HeightRequest="38"
                HorizontalOptions="Center"
                SemanticProperties.Description="Button open sidebar"
                Source="hamburger.svg"
                VerticalOptions="Center"
                WidthRequest="38" />
        </Border>
        <Grid Grid.Column="1" IsVisible="{Binding IsVisibleGreetingContent, Source={x:Reference navBarRootContent}, Mode=OneWay}">
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="10"
                VerticalOptions="Center">
                <Label
                    x:Name="lbHi"
                    FontAttributes="Bold"
                    HorizontalOptions="StartAndExpand"
                    Text="Hi, ..."
                    VerticalOptions="Center" />
                <Image
                    HorizontalOptions="End"
                    IsAnimationPlaying="True"
                    PropertyChanged="Image_PropertyChanged"
                    Source="hand.svg"
                    WidthRequest="30" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentView>
