<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="VeganLife.Views.Controls.FlyoutHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="{AppThemeBinding Dark=White,
                                      Light={StaticResource PrimaryLight}}">
    <Frame
        Margin="10"
        Padding="0"
        BackgroundColor="{AppThemeBinding Dark=Black,
                                          Light=White}"
        BorderColor="Transparent"
        CornerRadius="10">
        <StackLayout Margin="10" Spacing="10">
            <Grid>
                <HorizontalStackLayout Spacing="10">
                    <toolkit:AvatarView
                        BorderColor="Yellow"
                        BorderWidth="1"
                        CornerRadius="40"
                        HeightRequest="80"
                        ImageSource="profile_girl_strong"
                        WidthRequest="80" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Ẩn danh"
                        VerticalOptions="CenterAndExpand" />
                </HorizontalStackLayout>
                <Label
                    FontFamily="FontAwesomeSolid"
                    FontSize="18"
                    HorizontalOptions="End"
                    Text="&#xf044;" />
            </Grid>
            <Label Text="Bạn đang hoạt động ẩn danh, điền các thông tin để có trải nghiệm tốt hơn" />
        </StackLayout>
    </Frame>
</ContentView>