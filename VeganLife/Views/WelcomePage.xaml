<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="VeganLife.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:VeganLife.Views.Base"
    xmlns:viewmodel="clr-namespace:VeganLife.ViewModels"
    x:DataType="viewmodel:WelcomeViewModel"
    x:TypeArguments="viewmodel:WelcomeViewModel">
    <VerticalStackLayout>
        <CarouselView
            HorizontalOptions="FillAndExpand"
            IndicatorView="indicatorView"
            ItemsSource="{Binding ListImage, Mode=OneWay}"
            VerticalOptions="CenterAndExpand">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="viewmodel:WelcomeImage">
                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Image Aspect="AspectFit" Source="{Binding Image, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>
        <IndicatorView
            x:Name="indicatorView"
            HorizontalOptions="Center"
            IndicatorColor="LightGray"
            SelectedIndicatorColor="DarkGray" />
    </VerticalStackLayout>
</base:BasePage>