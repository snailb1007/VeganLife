<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="VeganLife.Views.Popups.BmiResultPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Animations="clr-namespace:Mopups.Animations;assembly=Mopups"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:converterCustom="clr-namespace:VeganLife.Helpers.Converter"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:vm="clr-namespace:VeganLife.ViewModels.PopupViewModels"
    x:DataType="vm:BmiResultPopupViewmodel"
    BackgroundColor="#80808080"
    BackgroundInputTransparent="False">
    <Mopups:PopupPage.Animation>
        <Animations:MoveAnimation PositionIn="Center" PositionOut="Center" />
    </Mopups:PopupPage.Animation>
    <Mopups:PopupPage.Resources>
        <ResourceDictionary>
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
            <converterCustom:OnlyLineBreakConverter x:Key="OnlyLineBreakConverter" />
        </ResourceDictionary>
    </Mopups:PopupPage.Resources>
    <Grid
        BackgroundColor="Transparent"
        ColumnDefinitions="*,8.5*,*"
        RowDefinitions="*,Auto,*">
        <Border
            Grid.Row="1"
            Grid.Column="1"
            VerticalOptions="FillAndExpand">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <Grid RowDefinitions="Auto,*" VerticalOptions="FillAndExpand">
                <Grid Grid.Row="0" IsClippedToBounds="True">
                    <VerticalStackLayout Spacing="10" VerticalOptions="FillAndExpand">
                        <Label
                            Margin="0,20,0,0"
                            FontAttributes="Bold"
                            FontSize="20"
                            HorizontalOptions="Center"
                            Text="{x:Static translate:AppResources.title_bmiPopup}" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="25"
                            HorizontalOptions="Center"
                            Text="{Binding BmiResultText, Mode=OneWay}"
                            VerticalOptions="Center" />
                        <VerticalStackLayout Margin="10,0">
                            <Label
                                HorizontalTextAlignment="Center"
                                IsVisible="{Binding ClassifyLabel, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                                LineBreakMode="TailTruncation"
                                MaxLines="1"
                                Text="{Binding ClassifyLabel}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="15"
                                HorizontalTextAlignment="Center"
                                IsVisible="{Binding Message, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                                LineBreakMode="WordWrap"
                                LineHeight="1.2"
                                Text="{Binding Message}" />
                            <Label
                                HorizontalTextAlignment="Center"
                                LineBreakMode="TailTruncation"
                                LineHeight="1.2"
                                MaxLines="1">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span
                                            FontSize="16"
                                            Text="*Note: "
                                            TextColor="Red" />
                                        <Span FontSize="15" Text="{Binding Note, Converter={StaticResource OnlyLineBreakConverter}}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">
                            <Button
                                Background="Transparent"
                                BackgroundColor="Transparent"
                                FontFamily="{StaticResource FontAwesomeSolid}"
                                Text="&#xf2f9;"
                                TextColor="Gray" />
                            <Button
                                Grid.Column="1"
                                Background="Transparent"
                                BackgroundColor="Transparent"
                                FontFamily="{StaticResource FontAwesomeSolid}"
                                Text="&#xf061;"
                                TextColor="Gray" />
                            <Button
                                Grid.Column="2"
                                BorderColor="SkyBlue"
                                CornerRadius="20"
                                Text="Save"
                                TextColor="SkyBlue" />
                        </Grid>
                        <Label HorizontalOptions="Center" Text="Đi tới trang phân tích" />
                    </VerticalStackLayout>
                </Grid>
                <Grid
                    Grid.Row="1"
                    BackgroundColor="{Binding BmiStatusColor, Mode=OneWay}"
                    HeightRequest="48"
                    HorizontalOptions="Fill"
                    VerticalOptions="FillAndExpand">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                    </Grid.GestureRecognizers>
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        HorizontalOptions="Center"
                        Text="Close"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Mopups:PopupPage>