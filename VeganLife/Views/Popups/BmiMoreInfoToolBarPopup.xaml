<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="VeganLife.Views.Popups.BmiMoreInfoToolBarPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="False">
    <Border StrokeShape="RoundRectangle 5" StrokeThickness="0">
        <Grid
            x:Name="mainGrid"
            BackgroundColor="Transparent"
            RowDefinitions="*,48">
            <VerticalStackLayout Padding="15" Spacing="10">
                <Grid ColumnDefinitions="*,48">
                    <Label
                        FontAttributes="Bold"
                        HorizontalOptions="CenterAndExpand"
                        Text="Thông tin thêm"
                        VerticalOptions="End" />
                    <Button
                        Grid.Column="1"
                        Background="Transparent"
                        BackgroundColor="Transparent"
                        FontFamily="{StaticResource FontAwesomeSolid}"
                        Text="&#xf00d;"
                        TextColor="Gray"
                        VerticalOptions="Start" />
                </Grid>
                <Label Text="Các tài liệu được tham khảo và đề cập xuyên suốt được liệt kê dưới đây:" />
            </VerticalStackLayout>
            <Grid
                Grid.Row="1"
                BackgroundColor="{StaticResource PrimaryDark}"
                HeightRequest="48"
                HorizontalOptions="Fill"
                VerticalOptions="FillAndExpand">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Close_TapGestureRecognizer_Tapped" />
                </Grid.GestureRecognizers>
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="Center"
                    Text="Close"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Grid>
        </Grid>
    </Border>
</toolkit:Popup>