<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="VeganLife.Views.Popups.AboutAppPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    CanBeDismissedByTappingOutsideOfPopup="False">
    <Border StrokeShape="RoundRectangle 5" StrokeThickness="0">
        <Grid
            x:Name="rootGrid"
            Padding="15"
            BackgroundColor="Transparent"
            ColumnDefinitions="65,*"
            ColumnSpacing="20"
            RowDefinitions="65, *"
            RowSpacing="20">
            <Border StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
                <Image Aspect="AspectFit" Source="app_icon.jpg" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="5">
                <Label
                    FontAttributes="Bold"
                    FontFamily="{StaticResource PlayfairDisplaySemiBold}"
                    FontSize="Medium"
                    Text="{x:Static translate:AppResources.app_name}" />
                <Label
                    x:Name="lbVersion"
                    FontAttributes="Bold"
                    FontSize="Medium" />
            </VerticalStackLayout>
            <VerticalStackLayout
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Spacing="5">
                <Label Text="{x:Static translate:AppResources.app_slogan}" />
                <Label Text="{x:Static translate:AppResources.app_detail}" />
                <Label Margin="0,10,0,0">
                    <!--  TODO: https://github.com/dotnet/maui/pull/12027  -->
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer />
                    </Label.GestureRecognizers>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static translate:AppResources.app_allow}" TextColor="Gray" />
                            <Span
                                Text="{x:Static translate:AppResources.app_TermsAndConditions}"
                                TextColor="DeepSkyBlue"
                                TextDecorations="Underline">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TermsAndConditions_Tapped" />
                                </Span.GestureRecognizers>
                            </Span>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label>
                    <!--  TODO: https://github.com/dotnet/maui/pull/12027  -->
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer />
                    </Label.GestureRecognizers>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static translate:AppResources.app_allow}" TextColor="Gray" />
                            <Span
                                Text="{x:Static translate:AppResources.app_PrivacyPolicy}"
                                TextColor="DeepSkyBlue"
                                TextDecorations="Underline">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PrivacyPolicy_Tapped" />
                                </Span.GestureRecognizers>
                            </Span>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Grid Margin="0,20,0,0">
                    <Button
                        Background="#fcd684"
                        BackgroundColor="#fcd684"
                        BorderWidth="0"
                        Clicked="Close_Clicked"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        FontFamily="{StaticResource PlayfairDisplaySemiBold}"
                        HorizontalOptions="End"
                        Text="{x:Static translate:AppResources.close_common}"
                        TextColor="Black" />
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Border>
</toolkit:Popup>
