<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="VeganLife.Views.Popups.AboutAppPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    CanBeDismissedByTappingOutsideOfPopup="False"
    Color="Transparent">
    <Border
        BackgroundColor="Transparent"
        StrokeShape="RoundRectangle 5"
        StrokeThickness="0">
        <Grid
            x:Name="rootGrid"
            Padding="15"
            BackgroundColor="White"
            ColumnDefinitions="65,*"
            ColumnSpacing="20"
            IsClippedToBounds="True"
            RowDefinitions="65, *"
            RowSpacing="20">
            <Border StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
                <Image Aspect="AspectFit" Source="app_icon.jpg" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="5">
                <Label
                    FontAttributes="Bold"
                    FontFamily="PlayfairDisplaySemiBold"
                    FontSize="Medium"
                    Text="{x:Static translate:AppResources.app_name}" />
                <Label
                    x:Name="lbVersion"
                    FontAttributes="Bold"
                    FontSize="Medium" />
            </VerticalStackLayout>
            <VerticalStackLayout
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Spacing="5">
                <Label Text="{x:Static translate:AppResources.app_slogan}" />
                <Label Text="{x:Static translate:AppResources.app_detail}" />
                <HorizontalStackLayout Margin="0,10,0,0">
                    <CheckBox x:Name="termsAndConditionsCheckBox" VerticalOptions="Center" />
                    <Label VerticalOptions="Center">
                        <!--  TODO: https://github.com/dotnet/maui/pull/12027  -->
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer />
                        </Label.GestureRecognizers>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static translate:AppResources.app_allow}" TextColor="Gray" />
                                <Span
                                    Text="{x:Static translate:AppResources.app_TermsAndConditions}"
                                    TextColor="DeepSkyBlue"
                                    TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="TermsAndConditions_Tapped" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <CheckBox x:Name="privacyPolicyCheckBox" VerticalOptions="Center" />
                    <Label VerticalOptions="Center">
                        <!--  TODO: https://github.com/dotnet/maui/pull/12027  -->
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer />
                        </Label.GestureRecognizers>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static translate:AppResources.app_allow}" TextColor="Gray" />
                                <Span
                                    Text="{x:Static translate:AppResources.app_PrivacyPolicy}"
                                    TextColor="DeepSkyBlue"
                                    TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="PrivacyPolicy_Tapped" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </HorizontalStackLayout>
                <Grid Margin="0,20,0,0">
                    <Button
                        BorderWidth="0"
                        Clicked="Close_Clicked"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        FontFamily="PlayfairDisplaySemiBold"
                        HorizontalOptions="End"
                        IsEnabled="False"
                        Text="{x:Static translate:AppResources.close_common}"
                        TextColor="White">
                        <Button.Triggers>
                            <MultiTrigger TargetType="Button">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding Source={x:Reference termsAndConditionsCheckBox}, Path=IsChecked}" Value="True" />
                                    <BindingCondition Binding="{Binding Source={x:Reference privacyPolicyCheckBox}, Path=IsChecked}" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="True" />
                            </MultiTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Border>
</toolkit:Popup>
