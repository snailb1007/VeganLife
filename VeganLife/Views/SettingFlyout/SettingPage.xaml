                HorizontalOptions="Start"
                Text="{AppThemeBinding Dark=&#xf186;,
                                       Light=&#xf185;}"
                TextColor="{AppThemeBinding Dark=White,
                                            Light=Orange}"
                VerticalOptions="Center" />
            <Label Text="{AppThemeBinding Dark={x:Static translate:AppResources.dark_settingPage}, Light={x:Static translate:AppResources.light_settingPage}}" VerticalOptions="Center" />
