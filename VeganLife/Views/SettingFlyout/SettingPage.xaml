        <StackLayout Orientation="Horizontal">
            <Label
                HorizontalOptions="StartAndExpand"
                Text="{x:Static translate:AppResources.collectLog_settingPage}"
                VerticalOptions="Center" />
            <Switch
                IsEnabled="{Binding IsLoading, Converter={StaticResource ReverseConverter}}"
                IsToggled="{Binding IsAllowCollectLogs, Mode=TwoWay}"
                ThumbColor="{StaticResource PrimaryLight}"
                VerticalOptions="Center" />
        </StackLayout>
        <Label
            Margin="0,10,0,0"
            HorizontalOptions="Start"
            Text="{x:Static translate:AppResources.technicalInfo_settingPage}"
            TextColor="Gray"
            VerticalOptions="Start" />
        <StackLayout Orientation="Horizontal">
            <Label
                HorizontalOptions="StartAndExpand"
                Text="{x:Static translate:AppResources.appVersion_settingPage}"
                VerticalOptions="Start" />
            <Label HorizontalOptions="End" Text="{Binding AppVersionDisplay, Mode=OneWay}" />
        </StackLayout>

        <Label
            HorizontalOptions="Start"
            IsEnabled="{Binding OpenLicensePageCommand.IsRunning, Converter={StaticResource ReverseConverter}, Mode=OneWay}"
            Text="{x:Static translate:AppResources.license_settingPage}">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenLicensePageCommand}" />
            </Label.GestureRecognizers>
        </Label>
    </VerticalStackLayout>
</base:BasePage>