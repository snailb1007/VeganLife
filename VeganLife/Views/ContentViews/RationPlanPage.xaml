<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="VeganLife.Views.ContentViews.RationPlanPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:VeganLife.Views.Base"
    xmlns:contentVM="clr-namespace:VeganLife.ViewModels.ContentViewModels"
    xmlns:control="clr-namespace:VeganLife.Views.Controls"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
    x:DataType="contentVM:RationPlanViewModel"
    x:TypeArguments="contentVM:RationPlanViewModel"
    Shell.NavBarIsVisible="False">
    <Grid
        BackgroundColor="#fef3e2"
        ColumnDefinitions="*"
        RowDefinitions="Auto,2*,*">
        <control:NavBarRootPageControl Margin="5" />
        <microcharts:ChartView
            Grid.Row="1"
            BackgroundColor="Transparent"
            Chart="{Binding PlantChart, Mode=OneWay}"
            HorizontalOptions="CenterAndExpand"
            VerticalOptions="CenterAndExpand" />
        <!--<Label
            Grid.Row="1"
            FontAttributes="Bold"
            FontSize="20"
            HorizontalOptions="Center"
            Text="2000 calories"
            TextColor="Gray"
            VerticalOptions="Center" />-->
    </Grid>
</base:BasePage>