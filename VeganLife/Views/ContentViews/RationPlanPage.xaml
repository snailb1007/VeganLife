<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="VeganLife.Views.ContentViews.RationPlanPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:VeganLife.Views.Base"
    xmlns:contentVM="clr-namespace:VeganLife.ViewModels.ContentViewModels"
    xmlns:control="clr-namespace:VeganLife.Views.Controls"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    x:DataType="contentVM:RationPlanViewModel"
    x:TypeArguments="contentVM:RationPlanViewModel"
    Shell.NavBarIsVisible="True">
    <Grid
        BackgroundColor="#fef3e2"
        ColumnDefinitions="*"
        RowDefinitions="2*,*">
        <lvc:PieChart
            Title="{Binding Title}"
            Grid.Column="1"
            Margin="10"
            HorizontalOptions="CenterAndExpand"
            LegendPosition="Bottom"
            LegendTextSize="25"
            PropertyChanged="PieChart_PropertyChanged"
            Series="{Binding Series}"
            VerticalOptions="Start" />
        <Label
            FontAttributes="Bold"
            FontSize="20"
            HorizontalOptions="Center"
            Text="2000 calories"
            TextColor="Gray"
            VerticalOptions="Center" />
    </Grid>
</base:BasePage>