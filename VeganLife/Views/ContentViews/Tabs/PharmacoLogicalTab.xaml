<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="VeganLife.Views.ContentViews.Tabs.PharmacoLogicalTab"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:VeganLife.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:viewmodel="clr-namespace:VeganLife.ViewModels.TabsViewModel"
    x:Name="selfPharmacoLogicalTab"
    x:DataType="viewmodel:PharmacoLogicalTabVM">
    <ContentView.Resources>
        <ResourceDictionary>
            <toolkit:IsListNotNullOrEmptyConverter x:Key="IsListNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ScrollView>
        <CollectionView
            x:Name="nutritionsCollection"
            Margin="10"
            ItemSizingStrategy="MeasureAllItems"
            ItemsSource="{Binding PharmacoLogicals, Mode=OneWay}"
            SelectionMode="None"
            VerticalOptions="Start">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <ContentView>
                    <VerticalStackLayout>
                        <ContentView
                            ControlTemplate="{StaticResource CantFindAnimationTemplate}"
                            HeightRequest="150"
                            HorizontalOptions="Center"
                            WidthRequest="150" />
                        <Label Text="{x:Static translate:AppResources.noVitamin_vitaminPage}" />
                        <Button
                            HorizontalOptions="Center"
                            Text="{x:Static translate:AppResources.askingAI_conversationChat}"
                            VerticalOptions="Center" />
                    </VerticalStackLayout>
                </ContentView>
            </CollectionView.EmptyView>
            <CollectionView.Header>
                <Label HorizontalOptions="End">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span
                                FontAttributes="Bold"
                                FontSize="Medium"
                                Text="{Binding PharmacoLogicals.Count}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:PharmacoLogicalModel">
                    <Border
                        Padding="5"
                        BackgroundColor="White"
                        HeightRequest="80"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.ItemSelectedCommand, Source={Reference selfPharmacoLogicalTab}}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout>
                            <Label
                                FontSize="Medium"
                                HorizontalOptions="FillAndExpand"
                                LineBreakMode="WordWrap"
                                MaxLines="2"
                                TextColor="Black"
                                VerticalOptions="Start">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Id}" />
                                        <!--<Span Text="{Binding VietnameseName, StringFormat=' ({0})'}" />-->
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="Small" Text="{Binding TimeAgo}" />
                            <BoxView
                                Margin="0,10,0,0"
                                HeightRequest="1"
                                HorizontalOptions="Fill"
                                Opacity="0.8"
                                Color="{StaticResource PrimaryDark}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </ScrollView>
</ContentView>
