<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="VeganLife.Views.ContentViews.Tabs.MacrosTab"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Compat.Maui"
    xmlns:usdaModel="clr-namespace:VeganLife.Models.CommunityFreeServiceModel"
    xmlns:vm="clr-namespace:VeganLife.ViewModels.TabsViewModel"
    x:DataType="vm:MacrosViewModel">
    <ScrollView>
        <CollectionView ItemsSource="{Binding UsdaFoodPreviews, Mode=OneWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="usdaModel:USDAFoodPreviewModel">
                    <Grid ColumnDefinitions="*,2*">
                        <Border StrokeShape="RoundRectangle 5" StrokeThickness="5">
                            <ffimageloading:CachedImage
                                Aspect="AspectFill"
                                DownsampleToViewSize="True"
                                Source="{Binding Image}" />
                        </Border>
                        <Label
                            Grid.Column="1"
                            Text="{Binding Name}"
                            VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </ScrollView>
</ContentView>
