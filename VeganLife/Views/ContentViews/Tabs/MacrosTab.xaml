<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="VeganLife.Views.ContentViews.Tabs.MacrosTab"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Compat.Maui"
    xmlns:sho="http://sharpnado.com"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:usdaModel="clr-namespace:VeganLife.Models.CommunityFreeServiceModel"
    xmlns:vm="clr-namespace:VeganLife.ViewModels.TabsViewModel"
    x:DataType="vm:MacrosViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <toolkit:IsListNullOrEmptyConverter x:Key="IsListNullOrEmptyConverter" />
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
        <DataTemplate x:Key="classicItemTemplate" x:DataType="usdaModel:USDAFoodPreviewModel">
            <sho:DraggableViewCell IsDraggable="False" IsEnabled="False">
                <ContentView>
                    <sho:MaterialFrame
                        Margin="10,0"
                        Padding="0"
                        CornerRadius="10"
                        HorizontalOptions="FillAndExpand"
                        MaterialTheme="Acrylic"
                        VerticalOptions="CenterAndExpand">
                        <Grid
                            Margin="5"
                            ColumnDefinitions="*,2*"
                            ColumnSpacing="5"
                            HeightRequest="95">
                            <sho:MaterialFrame
                                Margin="0"
                                Padding="0"
                                CornerRadius="8"
                                HorizontalOptions="FillAndExpand"
                                IsClippedToBounds="True"
                                VerticalOptions="FillAndExpand">
                                <ffimageloading:CachedImage
                                    Aspect="AspectFill"
                                    DownsampleToViewSize="True"
                                    LoadingPriority="Low"
                                    Source="{Binding Image, Mode=OneTime}" />
                            </sho:MaterialFrame>
                            <Label
                                Grid.Column="1"
                                Text="{Binding Name}"
                                VerticalOptions="Center" />
                        </Grid>
                    </sho:MaterialFrame>
                </ContentView>
            </sho:DraggableViewCell>
        </DataTemplate>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid RowDefinitions="*">
            <sho:CollectionView
                CollectionLayout="Vertical"
                IsVisible="{Binding Source={x:Reference spBtn}, Path=IsVisible, Converter={StaticResource InvertedBoolConverter}}"
                ItemHeight="110"
                ItemSpacing="5"
                ItemTemplate="{StaticResource classicItemTemplate}"
                ItemsSource="{Binding UsdaFoodPreviews, Mode=OneWay}"
                TapCommand="{Binding ItemSelectedChangedCommand}"
                VerticalOptions="Fill" />
            <Button
                x:Name="spBtn"
                Command="{Binding SupportRequestCommand}"
                HorizontalOptions="Center"
                IsVisible="{Binding UsdaFoodPreviews, Converter={StaticResource IsListNullOrEmptyConverter}}"
                Text="Support Request"
                VerticalOptions="Center" />
        </Grid>
    </ContentView.Content>
</ContentView>
