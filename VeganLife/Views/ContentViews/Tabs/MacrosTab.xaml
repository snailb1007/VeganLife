<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="VeganLife.Views.ContentViews.Tabs.MacrosTab"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:usdaModel="clr-namespace:VeganLife.Models.CommunityFreeServiceModel"
    xmlns:vm="clr-namespace:VeganLife.ViewModels.TabsViewModel"
    x:DataType="vm:MacrosViewModel">
    <VerticalStackLayout>
        <CollectionView ItemsSource="{Binding UsdaFoodPreviews, Mode=OneWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="usdaModel:USDAFoodPreviewModel">
                    <Grid ColumnDefinitions="*,4*">
                        <Image Source="{Binding Image}" />
                        <Label Grid.Column="1" Text="{Binding Name}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
