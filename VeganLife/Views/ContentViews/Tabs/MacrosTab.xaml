<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="VeganLife.Views.ContentViews.Tabs.MacrosTab"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:adsControl="clr-namespace:Plugin.MauiMTAdmob.Controls;assembly=Plugin.MauiMTAdmob"
    xmlns:controls="clr-namespace:VeganLife.Views.Controls"
    xmlns:ffTrans="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Maui"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:sho="http://sharpnado.com"
    xmlns:tabsView="clr-namespace:VeganLife.Views.ContentViews.Tabs"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:usdaModel="clr-namespace:VeganLife.Models.CommunityFreeServiceModel"
    xmlns:vm="clr-namespace:VeganLife.ViewModels.TabsViewModel"
    x:Name="macroTabRoot"
    x:DataType="vm:MacrosViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <toolkit:IsStringNullOrEmptyConverter x:Key="IsStringNullOrEmptyConverter" />
        </ResourceDictionary>
        <DataTemplate x:Key="classicItemTemplate" x:DataType="usdaModel:USDAFoodPreviewModel">
            <sho:MaterialFrame
                Margin="10,5"
                Padding="0"
                CornerRadius="10"
                HorizontalOptions="FillAndExpand"
                MaterialTheme="Acrylic"
                VerticalOptions="CenterAndExpand">
                <sho:MaterialFrame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ViewModel.ItemSelectedChangedCommand, Source={x:Reference macroTabRoot}, x:DataType={x:Type tabsView:MacrosTab}}" CommandParameter="{Binding .}" />
                </sho:MaterialFrame.GestureRecognizers>
                <Grid
                    Margin="5"
                    ColumnDefinitions="*,2*"
                    ColumnSpacing="5"
                    RowDefinitions="85">
                    <ffimageloading:CachedImage
                        x:Name="imgFoodPreview"
                        Aspect="AspectFill"
                        CacheType="Disk"
                        DownsampleToViewSize="True"
                        ErrorPlaceholder="app_icon.jpg"
                        LoadingPriority="Low"
                        Source="{Binding Image, Mode=OneTime}">
                        <ffimageloading:CachedImage.Transformations>
                            <ffTrans:RoundedTransformation Radius="8" />
                        </ffimageloading:CachedImage.Transformations>
                        <ffimageloading:CachedImage.Triggers>
                            <DataTrigger
                                Binding="{Binding Image, Converter={StaticResource IsStringNullOrEmptyConverter}}"
                                TargetType="ffimageloading:CachedImage"
                                Value="True">
                                <Setter Property="Source" Value="app_icon.jpg" />
                                <Setter Property="Opacity" Value="0.7" />
                            </DataTrigger>
                        </ffimageloading:CachedImage.Triggers>
                    </ffimageloading:CachedImage>
                    <ContentView ControlTemplate="{StaticResource LoadingAnimationTemplate}" IsVisible="{Binding IsLoading, Source={Reference imgFoodPreview}, x:DataType={x:Type ffimageloading:CachedImage}}" />
                    <Grid
                        Grid.Column="1"
                        ColumnDefinitions="*,Auto"
                        InputTransparent="False">
                        <Label
                            Grid.ColumnSpan="2"
                            FontAttributes="Bold"
                            FontSize="Medium"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Text="{Binding Name}"
                            VerticalOptions="Start" />
                        <sho:MaterialFrame
                            Grid.Column="1"
                            Margin="0,0,1,1"
                            Padding="8"
                            sho:Commands.Tap="{Binding ViewModel.ItemEditedTapCommand, Source={x:Reference macroTabRoot}, x:DataType={x:Type tabsView:MacrosTab}}"
                            sho:Commands.TapParameter="{Binding .}"
                            CornerRadius="4"
                            InputTransparent="False"
                            MaterialTheme="Acrylic"
                            VerticalOptions="End">
                            <Label
                                FontFamily="FALight"
                                FontSize="Medium"
                                InputTransparent="True"
                                Text="&#xf64e;" />
                        </sho:MaterialFrame>
                        <HorizontalStackLayout Spacing="4" VerticalOptions="End">
                            <Label
                                FontFamily="FAThin"
                                Text="&#xe339;"
                                TextColor="Red">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsPlantOrigin}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="TextColor" Value="Green" />
                                        <Setter Property="Text" Value="&#xf4d8;" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <sho:MaterialFrame
                                Margin="0"
                                Padding="2"
                                sho:Commands.Tap="{Binding ViewModel.USDABannerClickedCommand, Source={x:Reference macroTabRoot}, x:DataType={x:Type tabsView:MacrosTab}}"
                                CornerRadius="4"
                                IsVisible="{Binding IsUSDAFood, Mode=OneWay}"
                                LightThemeBackgroundColor="{StaticResource PrimaryOrange2}">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="Micro"
                                    Text="USDA"
                                    TextColor="{StaticResource PrimaryLight}"
                                    VerticalOptions="Center" />
                            </sho:MaterialFrame>
                        </HorizontalStackLayout>
                    </Grid>
                    <sho:MaterialFrame
                        Grid.ColumnSpan="2"
                        Padding="0"
                        IsVisible="{Binding IsShowingEdit}"
                        MaterialTheme="AcrylicBlur">
                        <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,*">
                            <HorizontalStackLayout
                                Grid.Row="1"
                                Margin="10,0,0,0"
                                Spacing="4"
                                VerticalOptions="Center">
                                <Border BackgroundColor="{StaticResource Gray100}" StrokeShape="RoundRectangle 10">
                                    <Entry
                                        Keyboard="Numeric"
                                        Placeholder="100"
                                        Text="{Binding Amount, Mode=OneWayToSource}"
                                        WidthRequest="100">
                                        <Entry.Behaviors>
                                            <toolkit:NumericValidationBehavior
                                                x:Name="amountEntryValidator"
                                                Flags="ValidateOnValueChanged"
                                                InvalidStyle="{StaticResource InvalidEntryStyle}"
                                                IsValid="False"
                                                MaximumDecimalPlaces="0"
                                                MaximumValue="10000"
                                                MinimumValue="5"
                                                ValidStyle="{StaticResource ValidEntryStyle}" />
                                        </Entry.Behaviors>
                                    </Entry>
                                </Border>
                                <Label
                                    Text="g(grams)"
                                    TextColor="Gray"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Button
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="5,10"
                                Command="{Binding ViewModel.AddMealLogsClickedCommand, Source={x:Reference macroTabRoot}, x:DataType={x:Type tabsView:MacrosTab}}"
                                CommandParameter="{Binding .}"
                                InputTransparent="False"
                                IsEnabled="{Binding IsValid, Source={x:Reference amountEntryValidator}, x:DataType={x:Type toolkit:NumericValidationBehavior}}"
                                Text="{x:Static translate:AppResources.addML_btn_macroTab}"
                                VerticalOptions="Center" />
                            <sho:MaterialFrame
                                Grid.ColumnSpan="2"
                                Margin="0,1,1,0"
                                Padding="2"
                                sho:Commands.Tap="{Binding ViewModel.ItemEditedTapCommand, Source={x:Reference macroTabRoot}, x:DataType={x:Type tabsView:MacrosTab}}"
                                sho:Commands.TapParameter="{Binding .}"
                                HorizontalOptions="End"
                                InputTransparent="False"
                                VerticalOptions="Start">
                                <Label
                                    FontFamily="FALight"
                                    FontSize="Medium"
                                    Text="&#xf00d;" />
                            </sho:MaterialFrame>
                        </Grid>
                    </sho:MaterialFrame>
                </Grid>
            </sho:MaterialFrame>
        </DataTemplate>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
            <Border
                Margin="5,60,5,0"
                IsVisible="{Binding IsFilterOpened}"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0">
                <Grid
                    BackgroundColor="{StaticResource Gray100}"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="0"
                    HeightRequest="60"
                    RowDefinitions="*">
                    <controls:MaterialFrameSelectControl Title="Vegan" IsSelected="{Binding IsVeganSelected, Mode=TwoWay}" />
                    <controls:MaterialFrameSelectControl
                        Title="Un-Vegan"
                        Grid.Column="1"
                        IsSelected="{Binding IsUnVeganSelected, Mode=TwoWay}" />
                </Grid>
            </Border>
            <RefreshView
                x:Name="refreshView"
                Grid.Row="1"
                IsClippedToBounds="False"
                IsRefreshing="False"
                Opacity="{x:Bind IsLoading ? 0.5 : 1.0}"
                Refreshing="RefreshView_Refreshing">
                <CollectionView
                    x:Name="FoodsPreviewCollection"
                    ItemSizingStrategy="MeasureFirstItem"
                    ItemTemplate="{StaticResource classicItemTemplate}"
                    ItemsSource="{Binding UsdaFoodPreviews}"
                    Scrolled="FoodsPreviewCollection_Scrolled"
                    SelectionMode="None"
                    VerticalScrollBarVisibility="Always">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="2" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Header>
                        <VerticalStackLayout>
                            <Grid
                                BackgroundColor="Transparent"
                                HeightRequest="60"
                                IsVisible="{Binding IsFilterOpened, Converter={StaticResource InvertedBoolConverter}}" />
                            <Grid Margin="0,0,10,0" IsVisible="{Binding IsBannerClosed, Converter={StaticResource InvertedBoolConverter}}">
                                <adsControl:MTAdView
                                    x:Name="mtAdFixed"
                                    AdsLoaded="OnAdLoaded"
                                    HeightRequest="50"
                                    HorizontalOptions="EndAndExpand"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    x:Name="closeLb"
                                    BackgroundColor="{StaticResource Gray300}"
                                    FontFamily="FARegular"
                                    FontSize="20"
                                    HeightRequest="20"
                                    HorizontalOptions="End"
                                    HorizontalTextAlignment="Center"
                                    IsVisible="False"
                                    Text="&#xf00d;"
                                    TextColor="White"
                                    VerticalOptions="Start"
                                    VerticalTextAlignment="Center"
                                    WidthRequest="20">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding CloseAdBannerCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                            <Label Margin="0,0,10,0" HorizontalOptions="End">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span
                                            FontSize="Medium"
                                            Text="{Binding UsdaFoodPreviews.Count}"
                                            TextColor="Green" />
                                        <Span Text="{x:Static translate:AppResources.result_lb}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </CollectionView.Header>
                    <CollectionView.EmptyView>
                        <ContentView>
                            <VerticalStackLayout>
                                <ContentView
                                    ControlTemplate="{StaticResource CantFindAnimationTemplate}"
                                    HeightRequest="150"
                                    HorizontalOptions="Center"
                                    WidthRequest="150" />
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                                    <Button
                                        Command="{Binding OpenAIConversationCommand}"
                                        HorizontalOptions="Center"
                                        Text="{x:Static translate:AppResources.askingAI_conversationChat}"
                                        VerticalOptions="Center" />
                                    <Button
                                        x:Name="spBtn"
                                        Command="{Binding SupportRequestCommand}"
                                        HorizontalOptions="Center"
                                        Text="Support Request"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </ContentView>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>
        </Grid>
    </ContentView.Content>
</ContentView>
