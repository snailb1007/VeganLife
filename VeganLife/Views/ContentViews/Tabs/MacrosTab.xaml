<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="VeganLife.Views.ContentViews.Tabs.MacrosTab"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:VeganLife.Views.Controls"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:sho="http://sharpnado.com"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:usdaModel="clr-namespace:VeganLife.Models.CommunityFreeServiceModel"
    xmlns:vm="clr-namespace:VeganLife.ViewModels.TabsViewModel"
    x:Name="macroTabRoot"
    x:DataType="vm:MacrosViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <toolkit:IsListNullOrEmptyConverter x:Key="IsListNullOrEmptyConverter" />
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
        <DataTemplate x:Key="classicItemTemplate" x:DataType="usdaModel:USDAFoodPreviewModel">
            <sho:MaterialFrame
                Margin="10,5"
                Padding="0"
                CornerRadius="10"
                HorizontalOptions="FillAndExpand"
                MaterialTheme="Acrylic"
                VerticalOptions="CenterAndExpand">
                <sho:MaterialFrame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                </sho:MaterialFrame.GestureRecognizers>
                <Grid
                    Margin="5"
                    ColumnDefinitions="*,2*"
                    ColumnSpacing="5"
                    RowDefinitions="85">
                    <sho:MaterialFrame
                        Margin="0"
                        Padding="0"
                        CornerRadius="8"
                        HorizontalOptions="FillAndExpand"
                        InputTransparent="True"
                        IsClippedToBounds="True"
                        VerticalOptions="FillAndExpand">
                        <ffimageloading:CachedImage
                            Aspect="AspectFill"
                            CacheType="Disk"
                            DownsampleToViewSize="True"
                            LoadingPriority="Low"
                            Source="{Binding Image, Mode=OneTime}" />
                    </sho:MaterialFrame>
                    <Grid Grid.Column="1">
                        <Label
                            FontAttributes="Bold"
                            FontSize="Medium"
                            Text="{Binding Name}"
                            VerticalOptions="Start" />
                        <HorizontalStackLayout VerticalOptions="End">
                            <sho:MaterialFrame
                                Margin="0"
                                Padding="2"
                                CornerRadius="4"
                                IsVisible="{Binding IsUSDAFood, Mode=OneWay}"
                                LightThemeBackgroundColor="{StaticResource PrimaryOrange2}">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="Micro"
                                    Text="USDA"
                                    TextColor="{StaticResource PrimaryLight}"
                                    VerticalOptions="Center" />
                            </sho:MaterialFrame>
                        </HorizontalStackLayout>
                        <Label
                            FontFamily="FAThin"
                            HorizontalOptions="End"
                            Text="&#xe339;"
                            TextColor="Red"
                            VerticalOptions="Start">
                            <Label.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsPlantOrigin}"
                                    TargetType="Label"
                                    Value="True">
                                    <Setter Property="TextColor" Value="Green" />
                                    <Setter Property="Text" Value="&#xf4d8;" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </Grid>
            </sho:MaterialFrame>
        </DataTemplate>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
            <Border
                Margin="5,0"
                IsVisible="{Binding IsFilterOpened}"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0">
                <Grid
                    BackgroundColor="{StaticResource Gray100}"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="0"
                    HeightRequest="60"
                    RowDefinitions="Auto,*">
                    <controls:MaterialFrameSelectControl Title="Vegan" IsSelected="{Binding IsVeganSelected, Mode=TwoWay}" />
                    <controls:MaterialFrameSelectControl
                        Title="Un-Vegan"
                        Grid.Column="1"
                        IsSelected="{Binding IsUnVeganSelected, Mode=TwoWay}" />
                </Grid>
            </Border>
            <RefreshView
                x:Name="refreshView"
                Grid.Row="1"
                IsClippedToBounds="False"
                IsRefreshing="False"
                Refreshing="RefreshView_Refreshing">
                <CollectionView
                    x:Name="FoodsPreviewCollection"
                    ItemSizingStrategy="MeasureFirstItem"
                    ItemTemplate="{StaticResource classicItemTemplate}"
                    ItemsSource="{Binding UsdaFoodPreviews}"
                    SelectionMode="None"
                    VerticalScrollBarVisibility="Always">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="2" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Header>
                        <Label Margin="0,0,10,0" HorizontalOptions="End">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span
                                        FontSize="Medium"
                                        Text="{Binding UsdaFoodPreviews.Count}"
                                        TextColor="Green" />
                                    <Span Text="{x:Static translate:AppResources.result_lb}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </CollectionView.Header>
                    <CollectionView.EmptyView>
                        <ContentView>
                            <VerticalStackLayout>
                                <ContentView
                                    ControlTemplate="{StaticResource CantFindAnimationTemplate}"
                                    HeightRequest="150"
                                    HorizontalOptions="Center"
                                    WidthRequest="150" />
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                                    <Button
                                        Command="{Binding OpenAIConversationCommand}"
                                        HorizontalOptions="Center"
                                        Text="Asking AI"
                                        VerticalOptions="Center" />
                                    <Button
                                        x:Name="spBtn"
                                        Command="{Binding SupportRequestCommand}"
                                        HorizontalOptions="Center"
                                        Text="Support Request"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </ContentView>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>
        </Grid>
    </ContentView.Content>
</ContentView>
