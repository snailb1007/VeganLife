<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="VeganLife.Views.ContentViews.ShellFlyoutFooterCustom"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sho="http://sharpnado.com"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations">
    <sho:MaterialFrame
        Margin="5"
        Padding="10"
        CornerRadius="8"
        LightThemeBackgroundColor="{StaticResource PrimaryDark}"
        MaterialTheme="Acrylic">
        <sho:MaterialFrame.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnButtonShareTapped" />
        </sho:MaterialFrame.GestureRecognizers>
        <HorizontalStackLayout HorizontalOptions="CenterAndExpand" Spacing="10">
            <Label
                Grid.Column="1"
                FontFamily="FARegular"
                FontSize="Large"
                HorizontalOptions="Center"
                Text="&#xf1e0;"
                TextColor="White"
                VerticalOptions="Center" />
            <Label
                FontAttributes="Bold"
                FontSize="Header"
                HorizontalOptions="Center"
                Text="{x:Static translate:AppResources.shareWithFriends_footer_shell}"
                TextColor="White"
                VerticalOptions="Center" />
        </HorizontalStackLayout>
    </sho:MaterialFrame>
</ContentView>
