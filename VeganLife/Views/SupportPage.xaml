<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="VeganLife.Views.SupportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:VeganLife.Views.Base"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:vm="clr-namespace:VeganLife.ViewModels"
    Title="{x:Static translate:AppResources.title_supportPage}"
    x:DataType="vm:SupportPageVM"
    x:TypeArguments="vm:SupportPageVM">
    <Grid RowDefinitions="3*, *">
        <Label
            Margin="10,20,10,0"
            FontFamily="PlayfairDisplaySemiBold"
            FontSize="16"
            HorizontalOptions="StartAndExpand"
            HorizontalTextAlignment="Start"
            Opacity="0.8"
            Text="{Binding Letter}"
            TextColor="{StaticResource Gray900}"
            VerticalOptions="Start" />
        <HorizontalStackLayout
            Grid.Row="1"
            Margin="20,0,0,20"
            Spacing="20"
            VerticalOptions="End">
            <Label
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Text="{x:Static translate:AppResources.chatWithUs_supportPage}"
                VerticalOptions="End" />
            <ImageButton
                Command="{Binding OpenCommunityCommand}"
                HeightRequest="48"
                Source="facebook2019.svg"
                VerticalOptions="End"
                WidthRequest="48" />
        </HorizontalStackLayout>
    </Grid>
</base:BasePage>