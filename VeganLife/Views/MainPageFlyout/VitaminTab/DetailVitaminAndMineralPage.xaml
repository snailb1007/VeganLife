<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="VeganLife.Views.MainPageFlyout.VitaminTab.DetailVitaminAndMineralPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:VeganLife.Views.Base"
    xmlns:control="clr-namespace:VeganLife.Views.Controls"
    xmlns:viewmodel="clr-namespace:VeganLife.ViewModels.ContentViewModels"
    x:DataType="viewmodel:DetailVitaminAndMineralViewModel"
    x:TypeArguments="viewmodel:DetailVitaminAndMineralViewModel"
    Shell.NavBarIsVisible="True">
    <ScrollView>
        <VerticalStackLayout Margin="16,16,16,0" Padding="0,0,0,16">
            <Label
                HorizontalOptions="Center"
                LineBreakMode="WordWrap"
                Text="{Binding Vitamin.Content}"
                VerticalOptions="FillAndExpand" />
        </VerticalStackLayout>
    </ScrollView>
</base:BasePage>