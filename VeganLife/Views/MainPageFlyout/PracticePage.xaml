<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VeganLife.Views.MainPageFlyout.PracticePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:VeganLife.ViewModels"
    Title="PracticePage"
    x:DataType="vm:PracticePageVM">
    <VerticalStackLayout>
        <Label
            HorizontalOptions="Center"
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" />
        <Button
            Command="{Binding PoseDetectionClickedCommand}"
            HorizontalOptions="Center"
            Text="Go pose detection" />
    </VerticalStackLayout>
</ContentPage>