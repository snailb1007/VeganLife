<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="VeganLife.Views.MainPageFlyout.NewsFeedPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:VeganLife.Views.Base"
    xmlns:control="clr-namespace:VeganLife.Views.Controls"
    xmlns:converter="clr-namespace:VeganLife.Helpers.Converter"
    xmlns:ggNewsModel="clr-namespace:VeganLife.Models.GoogleNewsModels"
    xmlns:model="clr-namespace:VeganLife.Models"
    xmlns:models="clr-namespace:VeganLife.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:viewmodel="clr-namespace:VeganLife.ViewModels"
    x:Name="newsFeedPageRoot"
    x:DataType="viewmodel:NewsFeedViewModel"
    x:TypeArguments="viewmodel:NewsFeedViewModel"
    BackgroundColor="{AppThemeBinding Light=#f8f8f8,
                                      Dark=Black}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <x:String x:Key="iconArrowRight">&#xf105;</x:String>
            <toolkit:IsNullConverter x:Key="NullToFalseConverter" />
            <toolkit:InvertedBoolConverter x:Key="ReverseConverter" />
            <Style TargetType="Frame">
                <Setter Property="BorderColor" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HasShadow" Value="False" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,Auto,*">
        <control:NavBarRootPageControl Margin="5" IsVisibleGreetingContent="False" />
        <VerticalStackLayout Grid.Row="1" Spacing="10">
            <StackLayout
                Grid.Row="1"
                Margin="10,0,0,0"
                Orientation="Horizontal">
                <Line
                    Margin="0,0,5,0"
                    BackgroundColor="{AppThemeBinding Dark=White,
                                                      Light=Black}"
                    HeightRequest="{Binding Source={x:Reference lbDiscoverTitle}, Path=FontSize}"
                    VerticalOptions="Center"
                    WidthRequest="5" />
                <Label
                    x:Name="lbDiscoverTitle"
                    Margin="0,5,0,0"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="{x:Static translate:AppResources.explore_common}"
                    VerticalOptions="Center" />
            </StackLayout>
            <CollectionView
                ItemsSource="{Binding DiscoveryMenu}"
                SelectionChanged="DiscoverMenu_SelectionChanged"
                SelectionMode="Single">
                <CollectionView.Header>
                    <BoxView
                        Background="Transparent"
                        BackgroundColor="Transparent"
                        WidthRequest="10"
                        Color="Transparent" />
                </CollectionView.Header>
                <CollectionView.Footer>
                    <BoxView
                        Background="Transparent"
                        BackgroundColor="Transparent"
                        WidthRequest="10"
                        Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout HorizontalItemSpacing="15" Orientation="Horizontal" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Discovery">
                        <VerticalStackLayout
                            AutomationProperties.IsInAccessibleTree="False"
                            SemanticProperties.Description="List discovery news"
                            Spacing="5">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Path=BindingContext.SelectDiscoveryMenuCommand, Source={x:Reference newsFeedPageRoot}}" CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Border
                                Padding="0"
                                BackgroundColor="Transparent"
                                HorizontalOptions="Center"
                                StrokeShape="RoundRectangle 50">
                                <Grid BackgroundColor="Transparent">
                                    <Image
                                        Aspect="AspectFill"
                                        Source="{Binding ImgSource}"
                                        WidthRequest="90" />
                                    <Label
                                        Padding="2,0"
                                        BackgroundColor="Gray"
                                        FontAttributes="Bold"
                                        HorizontalOptions="Center"
                                        Text="{Binding Title}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <Label
                                FontFamily="FALight"
                                FontSize="12"
                                HorizontalOptions="Center"
                                IsVisible="{Binding IsSelected}"
                                Text="&#xf192;"
                                TextColor="Black" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
        <Grid
            Grid.Row="2"
            Margin="0,10,0,0"
            RowDefinitions="*">
            <CollectionView
                x:Name="collectionFeeds"
                Margin="10,0"
                ItemSizingStrategy="MeasureFirstItem"
                ItemsSource="{Binding Feeds, Mode=OneWay}"
                RemainingItemsThreshold="2"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreItemCommand}"
                SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <Grid BackgroundColor="Transparent" HeightRequest="10" />
                </CollectionView.Header>
                <CollectionView.Footer>
                    <Grid BackgroundColor="Transparent" HeightRequest="10" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="ggNewsModel:Item">
                        <Border
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Dark=#2b2d2e,
                                                              Light=#ffffff}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference newsFeedPageRoot}, Path=BindingContext.SelectFeedItemCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid
                                BackgroundColor="Transparent"
                                ColumnDefinitions="*,Auto"
                                HorizontalOptions="FillAndExpand"
                                MinimumHeightRequest="10"
                                RowDefinitions="*"
                                VerticalOptions="CenterAndExpand">
                                <VerticalStackLayout Margin="5" Spacing="5">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        HorizontalTextAlignment="Start"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Text="{Binding title, Mode=OneTime}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                    <HorizontalStackLayout Grid.ColumnSpan="2" HorizontalOptions="StartAndExpand">
                                        <Label
                                            FontSize="12"
                                            Text="{Binding TimeAgoDisplay, Mode=OneTime}"
                                            TextColor="Gray" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="1"
                                    FontFamily="FALight"
                                    FontSize="30"
                                    HorizontalOptions="End"
                                    Text="{StaticResource iconArrowRight}"
                                    TextColor="Gray"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <ActivityIndicator
            Grid.Row="2"
            HorizontalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            VerticalOptions="Start"
            WidthRequest="50"
            Color="Black" />
    </Grid>
</base:BasePage>