<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="VeganLife.Views.MainPageFlyout.MealLogsAnalysisPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:VeganLife.Views.Base"
    xmlns:control="clr-namespace:VeganLife.Views.Controls"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:vm="clr-namespace:VeganLife.ViewModels"
    Title="Phân tích chi tiết"
    x:DataType="vm:MealLogsAnalysisPageVM"
    x:TypeArguments="vm:MealLogsAnalysisPageVM">
    <Grid RowDefinitions="Auto,*">
        <control:NavBarControl
            BackgroundColor="Transparent"
            VerticalOptions="Start"
            ZIndex="1" />
        <VerticalStackLayout Grid.Row="1">
            <lvc:PieChart
                x:Name="pieChart"
                Margin="10,10,10,0"
                HeightRequest="400"
                HorizontalOptions="Center"
                Series="{Binding Series}"
                WidthRequest="400" />
        </VerticalStackLayout>
    </Grid>
</base:BasePage>