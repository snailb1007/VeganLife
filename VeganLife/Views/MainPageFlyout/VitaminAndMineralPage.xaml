<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="VeganLife.Views.MainPageFlyout.VitaminAndMineralPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:VeganLife.Views.Base"
    xmlns:control="clr-namespace:VeganLife.Views.Controls"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:model="clr-namespace:VeganLife.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:viewmodel="clr-namespace:VeganLife.ViewModels.ContentViewModels"
    x:Name="selfVitaminAndMineralPage"
    x:DataType="viewmodel:VitaminAndMineralViewModel"
    x:TypeArguments="viewmodel:VitaminAndMineralViewModel"
    BackgroundColor="{AppThemeBinding Light=#f8f8f8,
                                      Dark=Black}"
    Shell.NavBarIsVisible="False">
    <base:BasePage.Resources>
        <ResourceDictionary>
            <toolkit:IsListNotNullOrEmptyConverter x:Key="IsListNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </base:BasePage.Resources>
    <Grid RowDefinitions="Auto,*">
        <control:NavBarRootPageControl Margin="5" IsVisibleGreetingContent="False" />
        <VerticalStackLayout Grid.Row="1" Margin="10">
            <Label
                FontAttributes="Bold"
                FontSize="18"
                HorizontalOptions="Start"
                IsVisible="{Binding Vitamins, Converter={StaticResource IsListNotNullOrEmptyConverter}}"
                Text="{x:Static translate:AppResources.explore_common}" />
            <Grid RowDefinitions="*">
                <CollectionView
                    x:Name="vitaminsCollection"
                    EmptyView="{x:Static translate:AppResources.noVitamin_vitaminPage}"
                    ItemSizingStrategy="MeasureFirstItem"
                    ItemsSource="{Binding Vitamins, Mode=OneWay}"
                    SelectionMode="None"
                    VerticalOptions="CenterAndExpand">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:VitaminModel">
                            <Border
                                Padding="5"
                                BackgroundColor="White"
                                HeightRequest="80"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.ItemSelectedCommand, Source={Reference selfVitaminAndMineralPage}}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,3*,0.5*" ColumnSpacing="5">
                                    <!--<Border
                                        Margin="2"
                                        Padding="0"
                                        StrokeShape="RoundRectangle 10">
                                        <ffimageloading:CachedImage
                                            Aspect="AspectFill"
                                            DownsampleToViewSize="True"
                                            ErrorPlaceholder="app_icon.jpg"
                                            LoadingPlaceholder="app_icon.jpg"
                                            Source="{Binding Image}" />
                                    </Border>-->
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label
                                            FontSize="Medium"
                                            HorizontalOptions="FillAndExpand"
                                            LineBreakMode="WordWrap"
                                            TextColor="Black"
                                            VerticalOptions="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Id}" />
                                                    <Span Text="{Binding VietnameseName, StringFormat=' ({0})'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label FontSize="Small" Text="{Binding Date}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </VerticalStackLayout>
    </Grid>
</base:BasePage>