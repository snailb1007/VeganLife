<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="VeganLife.Views.TutorialPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:VeganLife.Views.Base"
    xmlns:viewmodel="clr-namespace:VeganLife.ViewModels"
    x:DataType="viewmodel:TutorialViewModel"
    x:TypeArguments="viewmodel:TutorialViewModel"
    NavigationPage.HasNavigationBar="False">
    <Grid Margin="0,0,0,20" ColumnDefinitions="*,8*,*">
        <Image
            Grid.ColumnSpan="3"
            Aspect="AspectFit"
            Source="tutorial1.jpg"
            VerticalOptions="Start" />
        <Button
            Grid.Column="1"
            Command="{Binding SkipCommand}"
            FontAttributes="Bold"
            FontSize="Medium"
            Text="Skip"
            VerticalOptions="End" />
    </Grid>
</base:BasePage>