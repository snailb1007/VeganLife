<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VeganLife.Views.SettingTab.LicensePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:control="clr-namespace:VeganLife.Views.Controls"
    xmlns:models="clr-namespace:VeganLife.Models"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:vm="clr-namespace:VeganLife.ViewModels.ContentViewModels"
    x:DataType="vm:LicenseViewModel"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Content>
        <VerticalStackLayout>
            <control:NavBarControl Title="{x:Static translate:AppResources.license_settingPage}" />
            <CollectionView
                Margin="10"
                ItemSizingStrategy="MeasureFirstItem"
                ItemsSource="{Binding Licenses, Mode=OneWay}"
                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                SelectionChangedCommand="{Binding OpenLicenseDetailCommand}"
                SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LicenseModel">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                Padding="5,10"
                                FontSize="18"
                                Text="{Binding Name, Mode=OneWay}" />
                            <Line
                                BackgroundColor="#eeeeee"
                                HeightRequest="1"
                                Opacity="0.6" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>