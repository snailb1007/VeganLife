    <!--  custom  -->
    <Style x:Key="TitleFood" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="PlayfairDisplaySemiBold" />
    </Style>
    <DataTemplate x:Key="FoodPreviewCollection" x:DataType="modelFood:FoodPreviewModel">
        <Border
            Padding="0"
            BackgroundColor="{AppThemeBinding Light=White,
                                              Dark=Gray}"
            Stroke="Transparent"
            StrokeShape="RoundRectangle 10"
            Style="{StaticResource itemFoodStyle}">
            <Grid
                Margin="0"
                Padding="0"
                ColumnDefinitions="Auto, 3*, *"
                ColumnSpacing="10">
                <Border
                    Margin="5"
                    Padding="0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                    <ffimageloading:CachedImage
                        Aspect="AspectFill"
                        BackgroundColor="Transparent"
                        DownsampleToViewSize="True"
                        ErrorPlaceholder="mascot_snail"
                        FadeAnimationEnabled="True"
                        HeightRequest="70"
                        HorizontalOptions="End"
                        LoadingPlaceholder="mascot_snail"
                        LoadingPriority="Low"
                        Source="{Binding Image, Mode=OneTime}"
                        WidthRequest="70" />
                </Border>
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="10"
                    VerticalOptions="CenterAndExpand">
                    <Label
                        Margin="0"
                        FontAttributes="Bold"
                        HorizontalOptions="StartAndExpand"
                        LineBreakMode="TailTruncation"
                        MaxLines="2"
                        Style="{StaticResource TitleFood}"
                        Text="{Binding Name, Mode=OneTime}"
                        VerticalOptions="StartAndExpand" />
                    <HorizontalStackLayout Spacing="5">
                        <Label
                            FontFamily="FALight"
                            Text="&#xf017;"
                            VerticalOptions="Center" />
                        <Label Text="{Binding Time, Mode=OneTime}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
                <Button
                    Grid.Column="2"
                    Margin="0,0,5,0"
                    Padding="0,5"
                    AutomationProperties.IsInAccessibleTree="False"
                    Background="#f8f8f8"
                    BorderColor="Transparent"
                    BorderWidth="0"
                    Command="{Binding BookmarkClickedCommand}"
                    CommandParameter="{Binding .}"
                    CornerRadius="20"
                    SemanticProperties.Description="Button save food"
                    Text="Save"
                    TextColor="{StaticResource PrimaryDark}"
                    VerticalOptions="Center">
                    <Button.Triggers>
                        <DataTrigger
                            Binding="{Binding IsBookmarked}"
                            TargetType="Button"
                            Value="true">
                            <Setter Property="Text" Value="Saved" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=Gray}" />
                            <Setter Property="BorderColor" Value="Gray" />
                            <Setter Property="BorderWidth" Value="1" />
                            <Setter Property="Background" Value="Transparent" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
