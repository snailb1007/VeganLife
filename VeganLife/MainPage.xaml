<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    x:Class="VeganLife.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:VeganLife.Views.Base"
    xmlns:control="clr-namespace:VeganLife.Views.Controls"
    xmlns:converter="clr-namespace:VeganLife.Helpers.Converter"
    xmlns:model="clr-namespace:VeganLife.Models"
    xmlns:modelFood="clr-namespace:VeganLife.Models.FoodModel"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:viewmodel="clr-namespace:VeganLife.ViewModels"
    xmlns:views="clr-namespace:VeganLife.Views"
    x:Name="mainPageRoot"
    x:DataType="viewmodel:MainViewModel"
    x:TypeArguments="viewmodel:MainViewModel"
    BackgroundColor="{AppThemeBinding Light=#f8f8f8,
                                      Dark=Black}"
    Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="ReverseConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid
        IsEnabled="{Binding GoFoodDetailCommand.IsRunning, Converter={StaticResource ReverseConverter}}"
        RowDefinitions="56, Auto, *"
        RowSpacing="0">
        <Grid.Triggers>
            <DataTrigger
                Binding="{Binding GoFoodDetailCommand.IsRunning}"
                TargetType="Grid"
                Value="true">
                <Setter Property="Opacity" Value="0.7" />
            </DataTrigger>
            <DataTrigger
                Binding="{Binding LoadDataCommand.IsRunning}"
                TargetType="Grid"
                Value="true">
                <Setter Property="Opacity" Value="0.7" />
            </DataTrigger>
            <!--<DataTrigger
                Binding="{Binding IsSearchFocused}"
                TargetType="Grid"
                Value="true">
                <Setter Property="Opacity" Value="0.7" />
            </DataTrigger>-->
        </Grid.Triggers>
        <control:NavBarRootPageControl Margin="5" IsVisibleGreetingContent="True" />
        <!--  transparent view  -->
        <Grid BackgroundColor="Transparent" IsVisible="{Binding Source={x:Reference searchBar}, Path=IsFocused, Mode=OneWay}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="gridTransparent_TapGestureRecognizer_Tapped" />
            </Grid.GestureRecognizers>
        </Grid>
        <toolkit:Expander Grid.Row="1" IsExpanded="{Binding IsFilterContentExpaned}">
            <toolkit:Expander.Header>
                <Grid
                    Margin="0"
                    Padding="0"
                    ColumnDefinitions="10,*,10"
                    ColumnSpacing="0">
                    <Border Grid.Column="1" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, 45">
                            <SearchBar
                                x:Name="searchBar"
                                BackgroundColor="White"
                                HorizontalOptions="CenterAndExpand"
                                Placeholder="{x:Static translate:AppResources.searchPlace_mainPage}"
                                Text="{Binding SearchText, Mode=TwoWay}" />
                            <ImageButton
                                Grid.Column="1"
                                Margin="0"
                                Padding="0"
                                BackgroundColor="{StaticResource PrimaryDark}"
                                Command="{Binding FilterClickedCommand}"
                                CornerRadius="10"
                                HeightRequest="35"
                                HorizontalOptions="Center"
                                Source="filter.svg"
                                VerticalOptions="Center"
                                WidthRequest="35">
                                <ImageButton.Behaviors>
                                    <toolkit:AnimationBehavior>
                                        <toolkit:AnimationBehavior.AnimationType>
                                            <toolkit:FadeAnimation Opacity="0.5" />
                                        </toolkit:AnimationBehavior.AnimationType>
                                    </toolkit:AnimationBehavior>
                                </ImageButton.Behaviors>
                            </ImageButton>
                        </Grid>
                    </Border>
                </Grid>
            </toolkit:Expander.Header>
            <Grid
                Grid.Row="2"
                ColumnDefinitions="*"
                RowDefinitions="*">
                <CollectionView
                    Grid.Row="1"
                    Margin="0,10,0,10"
                    HorizontalOptions="FillAndExpand"
                    ItemsSource="{Binding Category, Mode=OneWay}"
                    ZIndex="0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="0" Orientation="Horizontal" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodel:FoodMenuCategoryModel">
                            <VerticalStackLayout Margin="20,0,0,0">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.CategoryClickedCommand, Source={x:Reference mainPageRoot}}" CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Border
                                    x:Name="img"
                                    HeightRequest="80"
                                    StrokeShape="RoundRectangle 50"
                                    WidthRequest="80">
                                    <Image
                                        x:Name="imgMenu"
                                        Aspect="AspectFill"
                                        HeightRequest="100"
                                        Source="{Binding ImgSource}"
                                        WidthRequest="100" />
                                </Border>
                                <Label
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    Text="{Binding Category}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <!--  transparent view  -->
                <Grid
                    BackgroundColor="Transparent"
                    IsVisible="{Binding Source={x:Reference searchBar}, Path=IsFocused, Mode=OneWay}"
                    ZIndex="1">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="gridTransparent_TapGestureRecognizer_Tapped" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Grid>
        </toolkit:Expander>
        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <Label
                Margin="10"
                FontAttributes="Bold"
                FontSize="18"
                HorizontalOptions="StartAndExpand"
                Text="{x:Static translate:AppResources.explore_common}"
                TextColor="Gray"
                VerticalOptions="Center" />
            <CollectionView
                x:Name="foodCollection"
                Grid.Row="1"
                Margin="20,10"
                ItemSizingStrategy="MeasureFirstItem"
                ItemTemplate="{StaticResource FoodPreviewCollection}"
                ItemsSource="{Binding Foods, Mode=OneWay}"
                SelectedItem="{Binding CurrentFoodSelected}"
                SelectionChangedCommand="{Binding GoFoodDetailCommand}"
                SelectionChangedCommandParameter="{Binding Source={x:Reference foodCollection}, Path=SelectedItem}"
                SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="5" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
            </CollectionView>
            <!--  transparent view  -->
            <Grid
                Grid.RowSpan="2"
                BackgroundColor="Transparent"
                IsVisible="{Binding Source={x:Reference searchBar}, Path=IsFocused, Mode=OneWay}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="gridTransparent_TapGestureRecognizer_Tapped" />
                </Grid.GestureRecognizers>
            </Grid>
        </Grid>

        <ActivityIndicator
            Grid.Row="1"
            Grid.RowSpan="2"
            IsRunning="False"
            VerticalOptions="Center">
            <ActivityIndicator.Triggers>
                <DataTrigger
                    Binding="{Binding GoFoodDetailCommand.IsRunning}"
                    TargetType="ActivityIndicator"
                    Value="true">
                    <Setter Property="IsRunning" Value="True" />
                </DataTrigger>
                <DataTrigger
                    Binding="{Binding LoadDataCommand.IsRunning}"
                    TargetType="ActivityIndicator"
                    Value="true">
                    <Setter Property="IsRunning" Value="True" />
                </DataTrigger>
            </ActivityIndicator.Triggers>
        </ActivityIndicator>
    </Grid>
</base:BasePage>
