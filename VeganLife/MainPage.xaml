            <Label
                FontAttributes="Bold"
                FontSize="18"
                Text="Dành cho bạn" />
            <CarouselView
                Grid.Row="1"
                Margin="20,10"
                HorizontalOptions="CenterAndExpand"
                ItemsSource="{Binding Category}"
                VerticalOptions="FillAndExpand">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="model:MenuModel">
                        <Grid ColumnDefinitions="20,*,20" RowDefinitions="0.5*,*,*">
                            <Border
                                Grid.Row="1"
                                Grid.RowSpan="3"
                                Grid.ColumnSpan="3"
                                StrokeShape="RoundRectangle 10" />
                            <Image
                                x:Name="imgMenu"
                                Grid.Row="0"
                                Grid.Column="1"
                                Aspect="AspectFill"
                                Source="{Binding ImgSource}" />
                        </Grid>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
        </Grid>-->

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*"
            RowDefinitions="Auto,*">
            <StackLayout Margin="10" Orientation="Horizontal">
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="StartAndExpand"
                    Text="Danh mục"
                    VerticalOptions="Center" />
                <Label
                    HorizontalOptions="End"
                    Text="tất cả &gt;"
                    VerticalOptions="Center" />
            </StackLayout>
            <CarouselView
                Grid.Row="1"
                Margin="0,10,0,10"
                HorizontalOptions="FillAndExpand"
                ItemsSource="{Binding Category}"
                PeekAreaInsets="100"
                PositionChanged="CarouselView_PositionChanged">
                <CarouselView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="0" Orientation="Horizontal" />
                </CarouselView.ItemsLayout>
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodel:FoodMenuCategoryModel">
                        <VerticalStackLayout Margin="20,0,0,0">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.CategoryClickedCommand, Source={x:Reference mainPageRoot}}" CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Border
                                x:Name="img"
                                HeightRequest="80"
                                StrokeShape="RoundRectangle 50"
                                WidthRequest="80">
                                <Image
                                    x:Name="imgMenu"
                                    Aspect="AspectFill"
                                    HeightRequest="100"
                                    Source="{Binding ImgSource}"
                                    WidthRequest="100" />
                            </Border>
                            <Label
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                Text="{Binding Category}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <Label
                Margin="10"
                FontAttributes="Bold"
                FontSize="18"
                HorizontalOptions="StartAndExpand"
                Text="Danh sách"
                TextColor="Gray"
                VerticalOptions="Center" />
            <CollectionView
                x:Name="foodCollection"
                Grid.Row="1"
                Margin="20,10"
                ItemTemplate="{StaticResource FoodPreviewCollection}"
                ItemsSource="{Binding Foods, Mode=OneWay}"
                SelectedItem="{Binding CurrentFoodSelected}"
                SelectionChangedCommand="{Binding GoFoodDetailCommand}"
                SelectionChangedCommandParameter="{Binding Source={x:Reference foodCollection}, Path=SelectedItem}"
                SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="5" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
            </CollectionView>
        </Grid>

        <ActivityIndicator
            Grid.RowSpan="3"
            IsRunning="False"
            VerticalOptions="Center">
            <ActivityIndicator.Triggers>
                <DataTrigger
                    Binding="{Binding GoFoodDetailCommand.IsRunning}"
                    TargetType="ActivityIndicator"
                    Value="true">
                    <Setter Property="IsRunning" Value="True" />
                </DataTrigger>
                <DataTrigger
                    Binding="{Binding LoadDataCommand.IsRunning}"
                    TargetType="ActivityIndicator"
                    Value="true">
                    <Setter Property="IsRunning" Value="True" />
                </DataTrigger>
            </ActivityIndicator.Triggers>
        </ActivityIndicator>
    </Grid>
</ContentPage>
