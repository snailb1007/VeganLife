<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VeganLife.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:viewmodel="clr-namespace:VeganLife.ViewModels"
    Title="{x:Static translate:AppResources.app_common_homeTab}"
    x:DataType="viewmodel:MainViewModel">

    <ScrollView>
        <RefreshView Command="{Binding RefreshFoodsCommand}">
            <ListView ItemsSource="{Binding Foods}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="3*,*">
                                <Grid>
                                    <!--<Image Source="{Binding Foods.Image}" />-->
                                </Grid>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </RefreshView>
    </ScrollView>

</ContentPage>
