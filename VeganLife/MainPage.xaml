<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VeganLife.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:control="clr-namespace:VeganLife.Views.Controls"
    xmlns:model="clr-namespace:VeganLife.Models"
    xmlns:modelFood="clr-namespace:VeganLife.Models.FoodModel"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:viewmodel="clr-namespace:VeganLife.ViewModels"
    xmlns:views="clr-namespace:VeganLife.Views"
    x:Name="mainPageRoot"
    Title="Món chay"
    x:DataType="viewmodel:MainViewModel"
    BackgroundColor="{AppThemeBinding Light=#f8f8f8,
                                      Dark=Black}">
    <Shell.SearchHandler>
        <control:FuntionAppSearchHandler
            ItemTemplate="{StaticResource AppFunctionTemplate}"
            Placeholder="Nhập để tìm chức năng"
            ShowsResults="True" />
    </Shell.SearchHandler>
    <ContentPage.Resources />
    <StackLayout>
        <StackLayout Margin="10" Orientation="Horizontal">
            <Label
                FontAttributes="Bold"
                FontSize="18"
                HorizontalOptions="StartAndExpand"
                Text="Loại"
                VerticalOptions="Center" />
            <Label
                HorizontalOptions="End"
                Text="tất cả &gt;"
                VerticalOptions="Center" />
        </StackLayout>
        <CollectionView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:MenuModel" />
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Label
            Margin="10"
            FontAttributes="Bold"
            FontSize="18"
            HorizontalOptions="StartAndExpand"
            Text="Danh sách"
            VerticalOptions="Center" />
        <CollectionView
            x:Name="foodCollection"
            Margin="20,10"
            ItemsSource="{Binding Foods}"
            SelectionChangedCommand="{Binding GoFoodDetailCommand}"
            SelectionChangedCommandParameter="{Binding Source={x:Reference foodCollection}, Path=SelectedItem}"
            SelectionMode="Single">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="5" Orientation="Vertical" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="modelFood:FoodPreviewModel">
                    <Border
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light=White,
                                                          Dark=Gray}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 10"
                        Style="{StaticResource itemFoodStyle}">
                        <Grid
                            Margin="0"
                            Padding="0"
                            ColumnDefinitions="Auto, 3*, *"
                            ColumnSpacing="10">
                            <Border
                                Margin="5"
                                Padding="0"
                                StrokeThickness="0"
                                BackgroundColor="Transparent"
                                HorizontalOptions="Start"
                                StrokeShape="RoundRectangle 10"
                                VerticalOptions="Center">
                                <Image
                                    Aspect="AspectFill"
                                    BackgroundColor="Transparent"
                                    HeightRequest="70"
                                    HorizontalOptions="End"
                                    Source="{Binding Image}"
                                    WidthRequest="70" />
                            </Border>
                            <Label
                                Grid.Column="1"
                                Margin="0"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                MaxLines="1"
                                Text="{Binding Name}"
                                VerticalOptions="Center" />
                            <Button
                                Grid.Column="2"
                                Margin="0,0,5,0"
                                Padding="0,5"
                                BackgroundColor="#f8f8f8"
                                Command="{Binding Source={x:Reference mainPageRoot}, Path=BindingContext.BookmarkClickedCommand}"
                                CommandParameter="{Binding .}"
                                CornerRadius="20"
                                Text="Save"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                TextColor="SkyBlue"
                                VerticalOptions="Center">
                                <Button.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsBookmarked}"
                                        TargetType="Button"
                                        Value="true">
                                        <Setter Property="Text" Value="Saved" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=Gray}" />
                                        <Setter Property="BorderColor" Value="Gray" />
                                        <Setter Property="BorderWidth" Value="1"/>
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>
