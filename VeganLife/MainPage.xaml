<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VeganLife.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:control="clr-namespace:VeganLife.Views.Controls"
    xmlns:model="clr-namespace:VeganLife.Models.FoodModel"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:viewmodel="clr-namespace:VeganLife.ViewModels"
    xmlns:views="clr-namespace:VeganLife.Views"
    Title="Món chay"
    x:DataType="viewmodel:MainViewModel">
    <Shell.SearchHandler>
        <control:FuntionAppSearchHandler
            ItemTemplate="{StaticResource AppFunctionTemplate}"
            Placeholder="Nhập để tìm chức năng"
            ShowsResults="True" />
    </Shell.SearchHandler>
    <CollectionView ItemsSource="{Binding Foods}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="model:FoodPreviewModel">
                <Frame Padding="0">
                    <Grid ColumnDefinitions="*,4*">
                        <Image Source="{Binding Image}" />
                        <Label Text="{Binding Name}" />
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
