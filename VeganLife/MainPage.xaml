<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VeganLife.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:control="clr-namespace:VeganLife.Views.Controls"
    xmlns:model="clr-namespace:VeganLife.Models"
    xmlns:modelFood="clr-namespace:VeganLife.Models.FoodModel"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:viewmodel="clr-namespace:VeganLife.ViewModels"
    xmlns:views="clr-namespace:VeganLife.Views"
    x:Name="mainPageRoot"
    Title="Món chay"
    x:DataType="viewmodel:MainViewModel">
    <Shell.SearchHandler>
        <control:FuntionAppSearchHandler
            ItemTemplate="{StaticResource AppFunctionTemplate}"
            Placeholder="Nhập để tìm chức năng"
            ShowsResults="True" />
    </Shell.SearchHandler>
    <StackLayout>
        <StackLayout Margin="10" Orientation="Horizontal">
            <Label
                FontAttributes="Bold"
                FontSize="18"
                HorizontalOptions="StartAndExpand"
                Text="Loại"
                VerticalOptions="Center" />
            <Label
                HorizontalOptions="End"
                Text="tất cả &gt;"
                VerticalOptions="Center" />
        </StackLayout>
        <CollectionView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:MenuModel" />
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Label
            Margin="10"
            FontAttributes="Bold"
            FontSize="18"
            HorizontalOptions="StartAndExpand"
            Text="Danh sách"
            VerticalOptions="Center" />
        <CollectionView
            Margin="10"
            ItemsSource="{Binding Foods}"
            SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="modelFood:FoodPreviewModel">
                    <Frame Padding="0" BorderColor="Transparent">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference mainPageRoot}, Path=BindingContext.GoFoodDetailCommand}" CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <Grid
                            Padding="0,0,0,5"
                            ColumnDefinitions="2.5*, *"
                            ColumnSpacing="10">
                            <Frame
                                Grid.Column="1"
                                Margin="2"
                                Padding="0"
                                BorderColor="Transparent">
                                <Image Source="{Binding Image}" />
                            </Frame>
                            <Label Text="{Binding Name}" VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>
