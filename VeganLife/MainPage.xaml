<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VeganLife.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:control="clr-namespace:VeganLife.Views.Controls"
    xmlns:converter="clr-namespace:VeganLife.Helpers.Converter"
    xmlns:model="clr-namespace:VeganLife.Models"
    xmlns:modelFood="clr-namespace:VeganLife.Models.FoodModel"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:viewmodel="clr-namespace:VeganLife.ViewModels"
    xmlns:views="clr-namespace:VeganLife.Views"
    x:Name="mainPageRoot"
    Title="Món chay"
    x:DataType="viewmodel:MainViewModel"
    BackgroundColor="{AppThemeBinding Light=#f8f8f8,
                                      Dark=Black}">

    <Shell.SearchHandler>
        <control:FuntionAppSearchHandler
            x:Name="shellSeachBox"
            FoodPreviews="{Binding Foods}"
            ItemTemplate="{StaticResource FoodPreviewSearchTemplate}"
            Placeholder="Nhập để tìm món ăn"
            ShowsResults="True">
            <control:FuntionAppSearchHandler.ClearIcon>
                <FontImageSource
                    FontFamily="FontAwesomeRegular"
                    Glyph="&#xf057;"
                    Size="8"
                    Color="{AppThemeBinding Dark=White,
                                            Light=Black}" />
            </control:FuntionAppSearchHandler.ClearIcon>
        </control:FuntionAppSearchHandler>
    </Shell.SearchHandler>
    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="ReverseConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid IsEnabled="{Binding GoFoodDetailCommand.IsRunning, Converter={StaticResource ReverseConverter}}" RowDefinitions="Auto, Auto, *">
        <Grid.Triggers>
            <DataTrigger
                Binding="{Binding GoFoodDetailCommand.IsRunning}"
                TargetType="Grid"
                Value="true">
                <Setter Property="Opacity" Value="0.7" />
            </DataTrigger>
            <DataTrigger
                Binding="{Binding LoadDataCommand.IsRunning}"
                TargetType="Grid"
                Value="true">
                <Setter Property="Opacity" Value="0.7" />
            </DataTrigger>
            <!--<DataTrigger
                Binding="{Binding IsSearchFocused}"
                TargetType="Grid"
                Value="true">
                <Setter Property="Opacity" Value="0.7" />
            </DataTrigger>-->
        </Grid.Triggers>
        <!--<StackLayout.Triggers>
            <DataTrigger
                Binding="{Binding Source={x:Reference shellSeachBox}, Path=IsFocused}"
                TargetType="StackLayout"
                Value="True">
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
        </StackLayout.Triggers>-->
