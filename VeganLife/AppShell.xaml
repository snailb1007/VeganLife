<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VeganLife.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:VeganLife"
    xmlns:view="clr-namespace:VeganLife.Views"
    Shell.FlyoutBehavior="Flyout">

    <TabBar>
        <Tab Title="Trang chủ">
            <Tab.Icon>
                <FontImageSource Glyph="&#xf015;"  FontFamily="AwesomeSolid"/>
            </Tab.Icon>
            <ShellContent
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="Home" />
        </Tab>
        <Tab Title="Tìm kiếm">
            <Tab.Icon>
                <FontImageSource Glyph="&#xf002;"  FontFamily="AwesomeSolid"/>
            </Tab.Icon>
            <ShellContent
                ContentTemplate="{DataTemplate view:SearchPage}"
                Route="Search" />
        </Tab>
        <Tab Title="Cài đặt">
            <Tab.Icon>
                <FontImageSource Glyph="&#xf013;"  FontFamily="AwesomeSolid"/>
            </Tab.Icon>
            <ShellContent
                ContentTemplate="{DataTemplate view:SettingPage}"
                Route="Setting" />
        </Tab>
    </TabBar>
</Shell>
