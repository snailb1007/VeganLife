<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VeganLife.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:contentViews="clr-namespace:VeganLife.Views.ContentViews"
    xmlns:controls="clr-namespace:VeganLife.Views.Controls"
    xmlns:local="clr-namespace:VeganLife"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:view="clr-namespace:VeganLife.Views"
    FlyoutHeaderBehavior="CollapseOnScroll"
    FlyoutIcon="hamburger"
    Shell.NavBarIsVisible="False"
    Shell.TabBarBackgroundColor="{AppThemeBinding Dark=Black,
                                                  Light=White}">
    <Shell.FlyoutHeader>
        <controls:FlyoutHeader />
    </Shell.FlyoutHeader>
    <FlyoutItem
        Title="{x:Static translate:AppResources.app_common_homeTab}"
        FlyoutDisplayOptions="AsSingleItem"
        Icon="{AppThemeBinding Dark=home_light,
                               Light=home}"
        Route="home">
        <Tab Title="{x:Static translate:AppResources.veganFood_feedPage}" Icon="vegan_food">
            <ShellContent
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="main"
                Shell.NavBarIsVisible="False" />
        </Tab>
        <Tab Title="{x:Static translate:AppResources.app_common_portionTab}" Icon="plan">
            <ShellContent
                ContentTemplate="{DataTemplate contentViews:RationPlanPage}"
                Route="ration_plan"
                Shell.NavBarIsVisible="False" />
        </Tab>
        <Tab Title="{x:Static translate:AppResources.app_common_vitaminsTab}" Icon="vitamin">
            <ShellContent
                ContentTemplate="{DataTemplate contentViews:VitaminAndMineralPage}"
                Route="vitamins_mineral"
                Shell.NavBarIsVisible="False" />
        </Tab>
        <Tab Title="{x:Static translate:AppResources.explore_common}" Icon="compass">
            <ShellContent
                ContentTemplate="{DataTemplate view:NewsFeedPage}"
                Route="news_feed"
                Shell.NavBarIsVisible="False" />
        </Tab>
        <Tab Title="{x:Static translate:AppResources.app_common_toolsTab}" Icon="calculator">
            <ShellContent
                ContentTemplate="{DataTemplate view:BMICalculatorPage}"
                Route="bmi_calculator"
                Shell.NavBarIsVisible="True" />
        </Tab>
    </FlyoutItem>
    <FlyoutItem
        Title="{x:Static translate:AppResources.app_common_bookmarkTab}"
        FlyoutDisplayOptions="AsSingleItem"
        Icon="{AppThemeBinding Dark=bookmarked_light,
                               Light=bookmarked}">
        <ShellContent
            ContentTemplate="{DataTemplate view:BookmarkPage}"
            Route="bookmark"
            Shell.NavBarIsVisible="True" />
    </FlyoutItem>
    <ShellContent
        Title="{x:Static translate:AppResources.app_common_webViewTab}"
        ContentTemplate="{DataTemplate view:WebViewPage}"
        Icon="{AppThemeBinding Dark=web_view_light,
                               Light=web_view}"
        Route="web_view"
        Shell.NavBarIsVisible="False" />
    <ShellContent
        Title="{x:Static translate:AppResources.app_common_settingTab}"
        ContentTemplate="{DataTemplate view:SettingPage}"
        Icon="{AppThemeBinding Dark=setting_light,
                               Light=setting}"
        Route="setting"
        Shell.NavBarIsVisible="True" />
</Shell>
