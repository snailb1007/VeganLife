<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VeganLife.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:contentViews="clr-namespace:VeganLife.Views.ContentViews"
    xmlns:controls="clr-namespace:VeganLife.Views.Controls"
    xmlns:local="clr-namespace:VeganLife"
    xmlns:simpleShell="clr-namespace:SimpleToolkit.SimpleShell;assembly=SimpleToolkit.SimpleShell"
    xmlns:translate="clr-namespace:VeganLife.Resources.Translations"
    xmlns:view="clr-namespace:VeganLife.Views"
    FlyoutHeaderBehavior="CollapseOnScroll"
    FlyoutIcon="hamburger"
    Shell.NavBarIsVisible="False"
    Shell.TabBarBackgroundColor="{AppThemeBinding Dark=Black,
                                                  Light=White}">
    <Shell.FlyoutHeader>
        <controls:FlyoutHeader />
    </Shell.FlyoutHeader>
    <FlyoutItem
        Title="Trang chủ"
        FlyoutDisplayOptions="AsSingleItem"
        Icon="{AppThemeBinding Dark=home_light,
                               Light=home}"
        Route="home">
        <Tab Title="Món chay" Icon="vegan_food">
            <ShellContent
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="main"
                Shell.NavBarIsVisible="true" />
        </Tab>
        <Tab Title="Khẩu phần" Icon="plan">
            <ShellContent
                Title="Khẩu phần"
                ContentTemplate="{DataTemplate contentViews:RationPlanPage}"
                Route="ration_plan" />
        </Tab>
        <Tab Title="Vitamins" Icon="vitamin">
            <ShellContent
                Title="Vitamins"
                ContentTemplate="{DataTemplate contentViews:VitaminAndMineralPage}"
                Route="vitamins_mineral" />
        </Tab>
        <Tab Title="Trạm đọc" Icon="compass">
            <ShellContent
                Title="Trạm đọc"
                ContentTemplate="{DataTemplate view:NewsFeedPage}"
                Route="news_feed"
                Shell.NavBarIsVisible="true" />
        </Tab>
        <Tab Title="Công cụ" Icon="calculator">
            <ShellContent
                ContentTemplate="{DataTemplate view:BMICalculatorPage}"
                Route="bmi_calculator"
                Shell.NavBarIsVisible="true" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem
        Title="Lưu trữ"
        FlyoutDisplayOptions="AsSingleItem"
        Icon="{AppThemeBinding Dark=bookmarked_light,
                               Light=bookmarked}">
        <ShellContent
            Title="Món ăn"
            ContentTemplate="{DataTemplate view:BookmarkPage}"
            Route="bookmark"
            Shell.NavBarIsVisible="true" />
    </FlyoutItem>

    <ShellContent
        Title="WebView"
        ContentTemplate="{DataTemplate view:WebViewPage}"
        Icon="{AppThemeBinding Dark=web_view_light,
                               Light=web_view}"
        Route="web_view"
        Shell.NavBarIsVisible="true" />
    <ShellContent
        Title="Cài đặt"
        ContentTemplate="{DataTemplate view:SettingPage}"
        Icon="{AppThemeBinding Dark=setting_light,
                               Light=setting}"
        Route="setting"
        Shell.NavBarIsVisible="true" />
</Shell>
