<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>VeganLife</RootNamespace>
		<UseMaui>true</UseMaui>
		<MauiVersion>9.0.50</MauiVersion>
		<AndroidXVersion>2.8.7.1</AndroidXVersion>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Display name -->
		<ApplicationTitle>HealthyChef</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.snailb.healthychef</ApplicationId>
		<ApplicationIdGuid>F4C59B5E-E230-4D45-85B2-8BF64759FFE1</ApplicationIdGuid>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0.79</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion> -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<!--TODO: net9, from toolkitMaui pack: https://github.com/CommunityToolkit/Maui/issues/2205-->
		<NoWarn>$(NoWarn);XC0103</NoWarn>

		<DefineConstants>$(DefineConstants);DATACENTER</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<DefineConstants>$(DefineConstants);DATACENTER</DefineConstants>
		<Optimize>True</Optimize>
		<EmbedAssembliesIntoApk>False</EmbedAssembliesIntoApk>
		<LangVersion>latest</LangVersion>
		<WarningLevel>4</WarningLevel>
		<!--<_MauiForceXamlCForDebug>False</_MauiForceXamlCForDebug>-->
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android|AnyCPU'">
		<AndroidLinkTool>r8</AndroidLinkTool>
		<AndroidLinkMode>SdkOnly</AndroidLinkMode>
		<RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
		<RunAOTCompilation>true</RunAOTCompilation>
		<AndroidPackageFormats>aab;apk</AndroidPackageFormats>
		<AndroidEnableMultiDex>True</AndroidEnableMultiDex>
	</PropertyGroup>

	<!--<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-android|AnyCPU'">
	  -->
	<!--<AndroidEnableMultiDex>True</AndroidEnableMultiDex>-->
